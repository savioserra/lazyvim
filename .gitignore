# Repository-local or generated files
.DS_Store
*.log
*.tmp
*.bak
.build/
node_modules/

# Neovim runtime data belongs under XDG data/state/cache, not in Git.
.nvim-data/
.nvim-state/
.nvim-cache/

# The container E2E writes nothing into the checkout: its log lands in the
# scratch dir (or the path given as $1) and the flake-source extraction
# lives in the scratch dir too.
.worktrees/
_build/
deps/
.builds/
erl_crash.dump
t_*.err
