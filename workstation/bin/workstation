#!/bin/sh
# Sole public entry point. Runtime and release acquisition precede the engine.
# The engine itself is the Elixir OTP release: no Lua, no nvim invocation —
# nvim is a managed capability installed under the engine-owned opt root.
set -eu

script=$0
case "$script" in /*) ;; *) script=$PWD/$script ;; esac
links=0
while [ -L "$script" ]; do
	links=$((links + 1))
	[ "$links" -le 40 ] || { echo 'workstation: symlink loop' >&2; exit 1; }
	dir=$(CDPATH='' cd -P "$(dirname "$script")" && pwd -P)
	link=$(readlink "$script")
	case "$link" in /*) script=$link ;; *) script=$dir/$link ;; esac
done
script_dir=$(CDPATH='' cd -P "$(dirname "$script")" && pwd -P)
engine_root=$(CDPATH='' cd -P "$script_dir/.." && pwd -P)

# The checkout repo anchor (the mix umbrella root — the repo root since the
# elixir/ umbrella was flattened there; the legacy elixir/ arms stay until the
# cleanup card drops them). The
# shim lives at <repo>/workstation/bin/workstation, so the anchor is
# engine_root itself for a self-contained engine tree, or its parent for the
# checkout layout. A bare host matches neither and exports nothing — the
# release keeps its own fail-closed detection. Exporting for EVERY verb (not
# only bootstrap) is what makes a checkout-launched release anchor-aware:
# non-bootstrap verbs resolve the engine checkout (package assets, update
# steps) through WORKSTATION_ENGINE_REPO and fail closed without it.
repo_anchor=""
if [ -f "$engine_root/mix.exs" ]; then
	repo_anchor=$engine_root
elif [ "$(basename "$engine_root")" = workstation ] && [ -f "$engine_root/../mix.exs" ]; then
	repo_anchor=$engine_root/..
elif [ -f "$engine_root/elixir/mix.exs" ]; then
	repo_anchor=$engine_root
elif [ "$(basename "$engine_root")" = workstation ] && [ -f "$engine_root/../elixir/mix.exs" ]; then
	repo_anchor=$engine_root/..
fi
if [ -n "$repo_anchor" ]; then
	WORKSTATION_ENGINE_REPO=$repo_anchor
	export WORKSTATION_ENGINE_REPO
fi

# Carry the original rendezvous across repeated lifecycle launches.
# These are untrusted hints; only owned-account retirement validates/uses them.
if [ "${WORKSTATION_SESSION_CAPTURED:-}" != 1 ]; then
	WORKSTATION_SESSION_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}
	WORKSTATION_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-}
	WORKSTATION_SESSION_CAPTURED=1
fi
export WORKSTATION_SESSION_CAPTURED WORKSTATION_SESSION_RUNTIME_DIR WORKSTATION_SESSION_BUS_ADDRESS
unset DBUS_SESSION_BUS_ADDRESS

HOME=${WORKSTATION_HOME:-$HOME}
case "$HOME" in /*) ;; *) echo 'workstation: target home must be absolute' >&2; exit 1 ;; esac
export HOME
WORKSTATION_HOME=$HOME
USERPROFILE=$HOME
XDG_CONFIG_HOME=$HOME/.config
XDG_DATA_HOME=$HOME/.local/share
XDG_STATE_HOME=$HOME/.local/state
XDG_CACHE_HOME=$HOME/.cache
XDG_RUNTIME_DIR=$XDG_STATE_HOME/workstation/run
WORKSTATION_CACHE=$XDG_CACHE_HOME/workstation
TMPDIR=$XDG_RUNTIME_DIR/tmp
export WORKSTATION_HOME USERPROFILE XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_RUNTIME_DIR WORKSTATION_CACHE TMPDIR

case "$(uname -s)/$(uname -m)" in
	Linux/x86_64) platform=linux_x86_64 ;;
	Darwin/arm64) platform=darwin_arm64 ;;
	*) echo 'workstation: supported hosts are Linux x86_64 (including WSL) and Darwin arm64' >&2; exit 1 ;;
esac
umask 077
mkdir -p "$TMPDIR"
chmod 700 "$XDG_RUNTIME_DIR"

# The installed engine release: built from the checkout by the installer
# (same acquisition path the engine's own release refresh drives), staged
# under the private opt root. Nothing else is ever executed.
release=$HOME/.local/opt/workstation/bin/workstation

# UTF-8 locale guard: Elixir expects a UTF-8 native name encoding, and a
# bare box often runs LANG= / LC_CTYPE=POSIX — the VM falls back to latin1,
# which Elixir documents as a malfunction risk for non-ASCII names (this
# payload ships dotfiles and font names). Guard every engine VM launch:
#   - a real UTF-8 locale: nothing to do.
#   - nothing set at all and the host ships the glibc-builtin C.UTF-8:
#     default LANG=C.UTF-8 for this launch. A fallback for the unconfigured
#     host, never a fix for its locale config — the banner says so.
#   - any other non-UTF-8 environment: prefix ELIXIR_ERL_OPTIONS with +fnu
#     (unicode filename mode) so name handling stays UTF-8-safe, and advise
#     a real UTF-8 locale on stderr.
# The decision body is mirrored verbatim in install.sh (which runs before
# any checkout file exists); keep the two in lockstep. Behavioral gate:
# .github/scripts/shim-locale-guard.sh.
ws_utf8_locale_guard() {
	[ "${ws_guard_done:-0}" -eq 0 ] || return 0
	ws_guard_done=1
	ws_locale_ok=0
	if command -v locale >/dev/null 2>&1; then
		ws_charmap=$(locale charmap 2>/dev/null) || ws_charmap=''
		case "$ws_charmap" in
			UTF-8|utf-8|UTF8|utf8) ws_locale_ok=1 ;;
		esac
	else
		# No locale(1) on the host: judge by the environment alone.
		case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
			*[Uu][Tt][Ff]-8|*[Uu][Tt][Ff]8) ws_locale_ok=1 ;;
		esac
	fi
	if [ "$ws_locale_ok" -eq 0 ]; then
		if [ -z "${LC_ALL:-}" ] && [ -z "${LC_CTYPE:-}" ] && [ -z "${LANG:-}" ] \
			&& locale -a 2>/dev/null | grep -Eqi '^C[.]utf-?8$'; then
			LANG=C.UTF-8
			export LANG
			printf '%s\n' 'workstation: no locale is configured; defaulting LANG=C.UTF-8 for this launch — a fallback for the unconfigured host, not a fix: configure a real UTF-8 locale' >&2
		else
			case ${ELIXIR_ERL_OPTIONS:-} in
				'') ELIXIR_ERL_OPTIONS=+fnu ;;
				*) ELIXIR_ERL_OPTIONS="+fnu $ELIXIR_ERL_OPTIONS" ;;
			esac
			export ELIXIR_ERL_OPTIONS
			printf '%s\n' 'workstation: the locale is not UTF-8; exporting ELIXIR_ERL_OPTIONS=+fnu for engine VM launches — configure a real UTF-8 locale on this host' >&2
		fi
	fi
}

if [ "${1:-}" = bootstrap ]; then
	# A checkout drives its own acquisition: the installer is pointed at the
	# repo anchor resolved above (it re-validates the umbrella before
	# building); a bare host keeps the runtime-only contract.
	# The installer is shell, not downloaded code; it installs the pinned
	# editor runtime and — when invoked from an engine checkout with a mise
	# toolchain — builds and installs the engine release. The handoff to the
	# engine's own bootstrap (backend capability, public launcher, refresh)
	# happens here, after acquisition committed.
	ws_utf8_locale_guard
	sh "$engine_root/bootstrap/install-runtime.sh" "$engine_root" "$platform"
	if [ ! -x "$release" ]; then
		echo 'workstation: bootstrap installed the runtime but no engine release; build it at the repo root (mise exec -- env MIX_ENV=prod mix release workstation --overwrite) and re-run workstation bootstrap' >&2
		exit 1
	fi
	# Runtime roots above stay private. Ordinary files must use the same default
	# modes as their native chezmoi recipes; private state sets explicit 0700/0600.
	umask 022
	exec "$release" bootstrap
fi

if [ ! -x "$release" ]; then
	echo 'workstation: engine release missing; run workstation bootstrap' >&2
	exit 1
fi
# Runtime roots above stay private. Ordinary files must use the same default
# modes as their native chezmoi recipes; private state sets explicit 0700/0600.
ws_utf8_locale_guard
umask 022
exec "$release" "$@"
