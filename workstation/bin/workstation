#!/bin/sh
# Sole public entry point. Runtime and release acquisition precede the engine.
# The engine itself is the Elixir OTP release: no Lua, no nvim invocation —
# nvim is a managed capability installed under the engine-owned opt root.
set -eu

script=$0
case "$script" in /*) ;; *) script=$PWD/$script ;; esac
links=0
while [ -L "$script" ]; do
	links=$((links + 1))
	[ "$links" -le 40 ] || { echo 'workstation: symlink loop' >&2; exit 1; }
	dir=$(CDPATH='' cd -P "$(dirname "$script")" && pwd -P)
	link=$(readlink "$script")
	case "$link" in /*) script=$link ;; *) script=$dir/$link ;; esac
done
script_dir=$(CDPATH='' cd -P "$(dirname "$script")" && pwd -P)
engine_root=$(CDPATH='' cd -P "$script_dir/.." && pwd -P)

# Carry the original rendezvous across repeated lifecycle launches.
# These are untrusted hints; only owned-account retirement validates/uses them.
if [ "${WORKSTATION_SESSION_CAPTURED:-}" != 1 ]; then
	WORKSTATION_SESSION_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}
	WORKSTATION_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-}
	WORKSTATION_SESSION_CAPTURED=1
fi
export WORKSTATION_SESSION_CAPTURED WORKSTATION_SESSION_RUNTIME_DIR WORKSTATION_SESSION_BUS_ADDRESS
unset DBUS_SESSION_BUS_ADDRESS

HOME=${WORKSTATION_HOME:-$HOME}
case "$HOME" in /*) ;; *) echo 'workstation: target home must be absolute' >&2; exit 1 ;; esac
export HOME
WORKSTATION_HOME=$HOME
USERPROFILE=$HOME
XDG_CONFIG_HOME=$HOME/.config
XDG_DATA_HOME=$HOME/.local/share
XDG_STATE_HOME=$HOME/.local/state
XDG_CACHE_HOME=$HOME/.cache
XDG_RUNTIME_DIR=$XDG_STATE_HOME/workstation/run
WORKSTATION_CACHE=$XDG_CACHE_HOME/workstation
TMPDIR=$XDG_RUNTIME_DIR/tmp
export WORKSTATION_HOME USERPROFILE XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME XDG_RUNTIME_DIR WORKSTATION_CACHE TMPDIR

case "$(uname -s)/$(uname -m)" in
	Linux/x86_64) platform=linux_x86_64 ;;
	Darwin/arm64) platform=darwin_arm64 ;;
	*) echo 'workstation: supported hosts are Linux x86_64 (including WSL) and Darwin arm64' >&2; exit 1 ;;
esac
umask 077
mkdir -p "$TMPDIR"
chmod 700 "$XDG_RUNTIME_DIR"

# The installed engine release: built from the checkout by the installer
# (same acquisition path the engine's own release refresh drives), staged
# under the private opt root. Nothing else is ever executed.
release=$HOME/.local/opt/workstation/bin/workstation

if [ "${1:-}" = bootstrap ]; then
	# A checkout drives its own acquisition: point the installer at the
	# engine umbrella so it builds and stages the release. An installed
	# release tree has no elixir/ umbrella; without the anchor the runtime
	# install above is the whole contract, exactly as on a bare host.
	if [ -f "$engine_root/elixir/mix.exs" ] && [ -f "$engine_root/bootstrap/install-runtime.sh" ]; then
		WORKSTATION_ENGINE_REPO=$engine_root
		export WORKSTATION_ENGINE_REPO
	fi
	# The installer is shell, not downloaded code; it installs the pinned
	# editor runtime and — when invoked from an engine checkout with a mise
	# toolchain — builds and installs the engine release. The handoff to the
	# engine's own bootstrap (backend capability, public launcher, refresh)
	# happens here, after acquisition committed.
	sh "$engine_root/bootstrap/install-runtime.sh" "$engine_root" "$platform"
	if [ ! -x "$release" ]; then
		echo 'workstation: bootstrap installed the runtime but no engine release; build it from elixir/ (mise exec -- env MIX_ENV=prod mix release workstation --overwrite) and re-run workstation bootstrap' >&2
		exit 1
	fi
	# Runtime roots above stay private. Ordinary files must use the same default
	# modes as their native chezmoi recipes; private state sets explicit 0700/0600.
	umask 022
	exec "$release" bootstrap
fi

if [ ! -x "$release" ]; then
	echo 'workstation: engine release missing; run workstation bootstrap' >&2
	exit 1
fi
# Runtime roots above stay private. Ordinary files must use the same default
# modes as their native chezmoi recipes; private state sets explicit 0700/0600.
umask 022
exec "$release" "$@"
