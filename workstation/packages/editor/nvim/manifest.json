      }
    },
    {
      "provider": "nvim-profile",
      "spec": {
        "entry": {
          "id": "go",
          "language_cases": [
            {
              "client": "gopls",
              "contents": "package behavior\n\nvar answer = 42\n",
              "filename": "attachment_test.go",
              "language": "go"
            }
          ],
          "lazyvim_extras": [
            "lazyvim.plugins.extras.lang.go"
          ],
          "requires": [
            "go"
          ]
        }
      }
    },
    {
      "provider": "nvim-profile",
      "spec": {
        "entry": {
          "id": "standard",
          "language_cases": [
            {
              "client": "lua_ls",
              "contents": "local answer = 42\n",
              "filename": "attachment-test.lua",
              "language": "lua"
            },
            {
              "client": "html",
              "contents": "<!doctype html><title>test</title>\n",
              "filename": "attachment-test.html",
              "language": "html"
            },
            {
              "client": "cssls",
              "contents": "body { color: red; }\n",
              "filename": "attachment-test.css",
              "language": "css"
            },
            {
              "client": "jsonls",
              "contents": "{ \"answer\": 42 }\n",
              "filename": "attachment-test.json",
              "language": "json"
            },
            {
              "client": "yamlls",
              "contents": "answer: 42\n",
              "filename": "attachment-test.yaml",
              "language": "yaml"
            },
            {
              "client": "marksman",
              "contents": "# Behavior test\n",
              "filename": "attachment-test.md",
              "language": "markdown"
            },
            {
              "client": "dockerls",
              "contents": "FROM scratch\n",
              "filename": "Dockerfile",
              "language": "dockerfile"
            }
          ],
          "lazyvim_extras": [
            "lazyvim.plugins.extras.lang.docker",
            "lazyvim.plugins.extras.lang.json",
            "lazyvim.plugins.extras.lang.markdown",
            "lazyvim.plugins.extras.lang.tailwind",
            "lazyvim.plugins.extras.lang.toml",
            "lazyvim.plugins.extras.lang.yaml"
          ]
        }
      }
    }
  ],
  "foundation": "foundation/editor",
  "id": "nvim",
  "requires": [
    "foundation",
    "node",
    "go"
  ],
  "schema": 1
}
