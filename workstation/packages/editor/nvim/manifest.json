{
  "contributes": [
    {
      "provider": "chezmoi",
      "spec": {
        "kind": "symlink",
        "target": ".local/bin/nvim",
        "to": "/home/golden/.local/opt/nvim/bin/nvim"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "content": {
          "$embed_assets": {
            "embed": "files/.config/nvim/lazy-lock.json",
            "marker": "__WORKSTATION_ENGINE_PINS__",
            "template": "files/modify/lazy-lock.json.sh"
          }
        },
        "executable": true,
        "kind": "modify",
        "target": ".config/nvim/lazy-lock.json"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.config/nvim/.gitignore",
        "kind": "file",
        "target": ".config/nvim/.gitignore"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.config/nvim/init.lua",
        "kind": "file",
        "target": ".config/nvim/init.lua"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.config/nvim/lazyvim.json",
        "kind": "file",
        "target": ".config/nvim/lazyvim.json"
      }
    },
    {
      "provider": "chezmoi",
