            "url": "https://github.com/nvm-sh/nvm/archive/refs/tags/v0.40.4.tar.gz"
          },
          "linux_x86_64": {
            "sha256": "5949b50e4640f2be2263f963952673d7f1a8745a83f05365e99f032fe78307fd",
            "url": "https://github.com/nvm-sh/nvm/archive/refs/tags/v0.40.4.tar.gz"
          }
        }
      }
    },
    {
      "provider": "download",
      "spec": {
        "version": "24.19.0",
        "archive": "tar.xz",
        "target": ".local/opt/nvm/versions/node/v24.19.0",
        "probe": {
          "argv": ["bin/node", "--version"],
          "output": "v{V}"
        },
        "assets": {
          "darwin_arm64": {
            "sha256": "3f1cf157479c1480352083105e13faf9d008ede98e7e157746b6df940d197b94",
            "url": "https://nodejs.org/dist/v24.19.0/node-v24.19.0-darwin-arm64.tar.xz"
          },
          "linux_x86_64": {
            "sha256": "14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647",
            "url": "https://nodejs.org/dist/v24.19.0/node-v24.19.0-linux-x64.tar.xz"
          }
        }
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.node-version",
        "kind": "file",
        "target": ".node-version"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/nvm.sh",
        "kind": "file",
        "target": ".config/shell/nvm.sh"
      }
    },
    {
      "provider": "shell",
      "spec": {
        "fragment": {
          "body": "[ -r \"$HOME/.config/shell/nvm.sh\" ] && . \"$HOME/.config/shell/nvm.sh\"",
          "id": "managed-nvm",
          "marker": "# chezmoi: load managed nvm"
        },
        "target": ".profile"
      }
    },
    {
      "provider": "shell",
      "spec": {
        "fragment": {
          "body": "[ -r \"$HOME/.config/shell/nvm.sh\" ] && . \"$HOME/.config/shell/nvm.sh\"",
          "id": "managed-nvm",
          "marker": "# chezmoi: load managed nvm"
        },
        "target": ".bashrc"
      }
    },
    {
      "provider": "shell",
      "spec": {
        "fragment": {
          "body": "[ -r \"$HOME/.config/shell/nvm.sh\" ] && . \"$HOME/.config/shell/nvm.sh\"",
          "id": "managed-nvm",
          "marker": "# chezmoi: load managed nvm"
        },
        "target": ".zshrc"
      }
    }
  ],
  "foundation": "foundation/runtime",
  "id": "node",
  "requires": [
    "foundation"
  ],
  "schema": 1
}
