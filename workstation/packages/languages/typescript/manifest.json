{
  "contributes": [
    {
      "provider": "download",
      "spec": {
        "version": "12.14.0",
        "archive": "tar.gz",
        "layout": "flat",
        "target": ".local/opt/pnpm",
        "probe": {
          "argv": ["pnpm", "--version"],
          "output": "{V}"
        },
        "assets": {
          "darwin_arm64": {
            "sha256": "50f48e0e17508952790a3fbf58fcf14f3b82efa5f594ca04ad904e29aaf854b0",
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.14.0/pnpm-darwin-arm64.tar.gz"
          },
          "linux_x86_64": {
            "sha256": "3910c3852136bed5bc1511b9137a45fd4357ed6b3970d9d08893641e9005867e",
            "url": "https://github.com/pnpm/pnpm/releases/download/v12.14.0/pnpm-linux-x64.tar.gz"
          }
        }
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "kind": "symlink",
        "target": ".local/bin/pnpm",
        "to": "../opt/pnpm/pnpm"
      }
    },
    {
      "provider": "nvim-profile",
      "spec": {
        "entry": {
          "formatter_cases": [
            {
              "contents": "const answer=42\n",
              "expected": "const answer = 42;\n",
              "filename": "format-test.js",
              "language": "javascript",
              "project_files": {
                ".prettierrc.json": "{}\n"
              }
            }
          ],
          "id": "typescript",
          "language_cases": [
            {
              "client": "typescript-tools",
              "contents": "const answer = 42;\n",
              "filename": "attachment-test.js",
              "language": "javascript"
            }
          ],
          "lazyvim_extras": [
            "lazyvim.plugins.extras.lang.typescript",
            "lazyvim.plugins.extras.linting.eslint",
            "lazyvim.plugins.extras.formatting.prettier"
          ],
          "mason_packages": [
            "typescript-language-server",
            "eslint-lsp",
            "prettier"
          ],
          "plugin_module": "languages.plugins.typescript",
          "requires": [
            "node"
          ]
        }
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/languages/plugins/typescript.lua",
        "kind": "file",
        "target": ".config/nvim/lua/languages/plugins/typescript.lua"
      }
    }
  ],
  "foundation": "foundation/runtime",
  "id": "typescript",
  "requires": [
    "node",
    "nvim"
  ],
  "schema": 1
}
