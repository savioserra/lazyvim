{
  "contributes": [
    {
      "provider": "chezmoi",
      "spec": {
        "kind": "directory",
        "private": true,
        "target": ".pi/agent"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.pi/agent/extensions/ntfy-notifier/README.md",
        "kind": "file",
        "target": ".pi/agent/extensions/ntfy-notifier/README.md"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.pi/agent/extensions/ntfy-notifier/extensions/ntfy-notifier.ts",
        "kind": "file",
        "target": ".pi/agent/extensions/ntfy-notifier/extensions/ntfy-notifier.ts"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.pi/agent/extensions/ntfy-notifier/package.json",
        "kind": "file",
        "target": ".pi/agent/extensions/ntfy-notifier/package.json"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.pi/agent/extensions/ntfy-notifier/src/ntfy.js",
        "kind": "file",
        "target": ".pi/agent/extensions/ntfy-notifier/src/ntfy.js"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.pi/agent/extensions/ntfy-notifier/test/ntfy.test.mjs",
        "kind": "file",
        "target": ".pi/agent/extensions/ntfy-notifier/test/ntfy.test.mjs"
      }
    },
    {
      "provider": "shell",
      "spec": {
        "fragment": {
          "body": "[ -r /etc/ntfy/notifier.env ] && { set -a; . /etc/ntfy/notifier.env; set +a; }",
          "id": "managed-ntfy-notifier-env",
          "marker": "# chezmoi: managed ntfy notifier env"
        },
        "target": ".profile"
      }
    }
  ],
  "foundation": "foundation/agent",
  "id": "pi-ntfy-notifier",
  "requires": [
    "agent"
  ],
  "schema": 1
}
