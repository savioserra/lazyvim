{
  "contributes": [
    {
      "provider": "mise",
      "spec": {
        "tools": [
          {
            "backend": "aqua:tmux/tmux-builds",
            "name": "tmux",
            "version": "3.7c"
          },
          {
            "backend": "github:aristocratos/btop",
            "name": "btop",
            "version": "1.4.7"
          }
        ]
      }
    },
    {
      "provider": "git",
      "spec": {
        "url": "https://github.com/tmux-plugins/tpm",
        "commit": "e261deb1b47614eed3400089ce7197dc68acc4eb",
        "target": ".tmux/plugins/tpm"
      }
    },
    {
      "provider": "git",
      "spec": {
        "url": "https://github.com/2KAbhishek/tmux2k",
        "commit": "07b3228b56c1a7b6109f00009df80b53f7eae892",
        "target": ".tmux/plugins/tmux2k"
      }
    },
    {
      "provider": "git",
      "spec": {
        "url": "https://github.com/tmux-plugins/tmux-yank",
        "commit": "acfd36e4fcba99f8310a7dfb432111c242fe7392",
        "target": ".tmux/plugins/tmux-yank"
      }
    },
    {
      "provider": "git",
      "spec": {
        "url": "https://github.com/tmux-plugins/tmux-resurrect",
        "commit": "cff343cf9e81983d3da0c8562b01616f12e8d548",
        "target": ".tmux/plugins/tmux-resurrect"
      }
    },
    {
      "provider": "git",
      "spec": {
        "url": "https://github.com/christoomey/vim-tmux-navigator",
        "commit": "e41c431a0c7b7388ae7ba341f01a0d217eb3a432",
        "target": ".tmux/plugins/vim-tmux-navigator"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "asset": "files/.tmux.conf",
        "kind": "file",
        "target": ".tmux.conf"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "kind": "remove",
        "target": ".config/tmux/themes/tmux2k.conf"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "kind": "symlink",
        "target": ".config/tmux/tmux.conf",
        "to": "../../.tmux.conf"
      }
    }
  ],
  "foundation": "foundation/terminal",
  "id": "tmux",
  "requires": [
    "foundation",
    "theme"
  ],
  "schema": 1,
  "supported_hosts": {
    "darwin": true,
    "linux": true
  }
}
