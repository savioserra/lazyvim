{
  "contributes": [
    {
      "provider": "download",
      "spec": {
        "version": "2.39.0",
        "archive": "zip",
        "layout": "flat",
        "target": ".local/opt/op",
        "probe": {
          "argv": ["op", "--version"],
          "output": "{V}"
        },
        "assets": {
          "darwin_arm64": {
            "sha256": "05391d3388a0c0b4f602691bedc1ab368541c487b6f14d2e3399743b4682af67",
            "url": "https://cache.agilebits.com/dist/1P/op2/pkg/v2.39.0/op_darwin_arm64_v2.39.0.zip"
          },
          "linux_x86_64": {
            "sha256": "6fba7f376b6c6dec49f41b06408930a43ad064cce103c6a2ce5b3d0413a86434",
            "url": "https://cache.agilebits.com/dist/1P/op2/pkg/v2.39.0/op_linux_amd64_v2.39.0.zip"
          }
        }
      }
    },
    {
      "provider": "shell",
      "spec": {
        "fragment": {
          "body": "[ -r /etc/pi/op.env ] && { set -a; . /etc/pi/op.env; set +a; }",
          "id": "managed-op-env",
          "marker": "# chezmoi: managed op env"
        },
        "target": ".profile"
      }
    },
    {
      "provider": "chezmoi",
      "spec": {
        "kind": "symlink",
        "target": ".local/bin/op",
        "to": "../opt/op/op"
      }
    }
  ],
  "foundation": "foundation/secrets",
  "id": "secrets",
  "requires": [
    "foundation"
  ],
  "schema": 1
}
