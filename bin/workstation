#!/bin/sh
# The workstation launcher: reads are nix evals over #workstation.report.<verb>;
# writes go through the generation's workstation-switch driver; the
# machine's choices live in hosts/local/machine.json (gitignored).
# shellcheck disable=SC2016 # jq filters carry their own $variables
set -eu

usage() {
	cat <<'EOF'
workstation — the nixpkgs-native workstation substrate

install (once per machine):
  init            capture this machine into hosts/local/machine.json (whiptail
                  dialogs prefilled with the detected values; a re-run
                  keeps every field you set), choose the languages and
                  the fleet, and run the first activation:
                    clone && workstation init
                  every later update is
                  `workstation apply` (WORKSTATION_NO_APPLY=1 skips the
                  first switch)
  setup           the inquiry again: every dialog of init, the current
                  answers prefilled — the identity, the languages and
                  the fleet are all re-asked

selection (per-machine capability flags, hosts/local/machine.json settings):
  add <path>...        enable capability(ies) on this machine
  remove <path>...     disable capability(ies)
  selected             this machine's rows: per path on/off/baseline + notes
  paths are <domain> or <domain>/<member> — `editor`,
  `languages/typescript`, `terminal/nunchux` (workstation selected lists
  them all). add and remove are idempotent, accept multiple paths, and
  offer `apply now?` on a TTY (WORKSTATION_NO_APPLY=1 skips the offer).

fleet (the agents' private network — tailscale + the A2A fleet):
  fleet           turn tailscale and the agent fleet on or off: start a
                  new fleet, join one (pairs with every member of your
                  tailscale user automatically) or stay standalone; init
                  asks the same once

peers (the A2A node's peers, hosts/local/peers.nix):
  peers           one screen over the tailnet's A2A agents (the online
                  nodes whose Agent Card answers on the A2A port): add a
                  peer, pair it (a shared token, exchanged over the
                  tailnet), tune its capabilities and timeout; then offer
                  the apply. Fleet members pair on their own (fleet);
                  peers adds other agents and tunes any peer

reads (nix eval over #workstation.report.<verb>):
  status          counts and the capability paths
  plan            the declared surface the next switch applies
  capabilities    the per-capability declared surface
                  (scope with an attrpath: workstation capabilities editor)

write plane (the generation's workstation-switch driver):
  apply|rollback|update|sync [--system]
                  inside a checkout (or with --flake / $WORKSTATION_FLAKE)
                  the switch builds that checkout; elsewhere it rebuilds
                  the staged generation snapshot

other:
  help            this text

The checkout resolves in this order: --flake PATH, $WORKSTATION_FLAKE,
the enclosing checkout (the first flake.nix walking up from $PWD), the
checkout init recorded ($WORKSTATION_CHECKOUT). Reads and switches build
the checkout's committed HEAD with the machine files in hosts/local;
WORKSTATION_WORKTREE=1 builds the working tree instead.
EOF
}

die() {
	printf 'workstation: %s\n' "$1" >&2
	exit "${2:-1}"
}

nixf() {
	if [ -n "$mdir" ]; then
		nix --extra-experimental-features 'nix-command flakes' "$@" --override-input machine-files "path:$mdir"
	else
		nix --extra-experimental-features 'nix-command flakes' "$@"
	fi
}

nix_eval() {
	nixf eval --json "$@"
}

# jq: the staged launcher carries it; a bare checkout builds it from the
# flake's own nixpkgs
jqx() {
	if [ -z "${WS_JQ:-}" ]; then
		if [ -n "${WORKSTATION_JQ:-}" ] && [ -x "$WORKSTATION_JQ" ]; then
			WS_JQ=$WORKSTATION_JQ
		elif command -v jq >/dev/null 2>&1; then
			WS_JQ=$(command -v jq)
		else
			WS_JQ=$(nix --extra-experimental-features 'nix-command flakes' build --no-link \
				--print-out-paths --inputs-from "${flake:-.}" nixpkgs#jq.bin)/bin/jq ||
				die 'jq is unavailable and did not build (nix build nixpkgs#jq.bin)' 1
		fi
	fi
	"$WS_JQ" "$@"
}

# machine_edit <jq filter> [jq args...] — rewrite hosts/local/machine.json in place
machine_edit() {
	filter=$1
	shift
	jqx "$@" "$filter" "$machine" >"$machine.edit.$$" || {
		rm -f "$machine.edit.$$"
		die "could not rewrite $machine" 1
	}
	mv "$machine.edit.$$" "$machine"
}

uncaptured() {
	grep -Eq '"(host|user)"[[:space:]]*:[[:space:]]*"TEMPLATE"' "$1"
}

# the apply offer: whiptail yes/no where the dialog tool exists, a printed
# next step otherwise; WORKSTATION_NO_APPLY=1 skips
offer_apply() {
	what=${1:-selection}
	if [ "${WORKSTATION_NO_APPLY:-}" = 1 ]; then
		printf 'workstation: %s saved; apply skipped (WORKSTATION_NO_APPLY=1) — next: workstation apply\n' "$what"
		return 0
	fi
	if command -v whiptail >/dev/null 2>&1; then
		if whiptail --title " workstation $what " --yesno \
			"Apply the new $what now?" 9 68; then
			if uncaptured_checkout; then
				die 'machine not captured — run: workstation init' 2
			fi
			if command -v workstation-switch >/dev/null 2>&1; then
				switch_flake
				exec workstation-switch apply
			fi
			die 'the write plane is the generation'\''s workstation-switch driver and it is not on PATH — apply the substrate first (the home lane stages it)' 2
		fi
		printf 'workstation: %s saved; apply deferred — next: workstation apply\n' "$what"
		return 0
	fi
	printf 'workstation: %s saved — next: workstation apply\n' "$what"
}

peers_helper() {
	nixf \
		build --no-link --print-out-paths "$ref#workstation-peers"
}

# --- the fleet: the A2A node's membership on the tailnet ---------------------
fleet_helper() {
	nixf \
		build --no-link --print-out-paths "$ref#workstation-fleet"
}

# fleet_get — member|standalone, empty when never chosen
fleet_get() {
	jqx -r '.settings.programs.hermes.a2a.enable | if . == null then "" elif . then "member" else "standalone" end' "$machine"
}

# fleet_set <member|standalone> — the A2A node and the tailscale transport
fleet_set() {
	if [ "$1" = member ]; then on=true; else on=false; fi
	machine_edit '.settings.programs.hermes.a2a.enable = $on | .settings.workstation.network.enable = $on' --argjson on "$on"
}

# fleet_choose <title> — the dialogs; fleet_mode becomes start|join|standalone
# (empty without whiptail: the machine file keeps its default)
fleet_choose() {
	fleet_mode=''
	command -v whiptail >/dev/null 2>&1 || return 0
	if command -v tailscale >/dev/null 2>&1 && tailscale status >/dev/null 2>&1; then
		:
	elif ! whiptail --title " $1 " --yes-button 'Turn on' --no-button 'Not now' --yesno \
		"Turn on tailscale?\n\nIt is the private network your machines' agents use to find and call each other (the agent fleet)." 12 70; then
		fleet_set standalone
		whiptail --title " $1 " --msgbox \
			"Tailscale and the agent fleet stay off on this machine.\n\nTurn them on any time: workstation fleet" 10 70
		fleet_mode=standalone
		return 0
	fi
	choice=$(whiptail --title " $1 " --notags --ok-button Select --cancel-button 'Not now' --menu \
		"This machine's agent fleet:" 13 70 3 \
		start 'Start a new fleet (this is the first machine)' \
		join 'Join a fleet (pair with every member on your tailnet)' \
		standalone 'Standalone (no agent fleet)' 3>&1 1>&2 2>&3) || choice=standalone
	case $choice in
	start | join)
		fleet_set member
		fleet_mode=$choice
		;;
	*)
		fleet_set standalone
		fleet_mode=standalone
		;;
	esac
}

# fleet_after <mode> — after the switch: the tailscale login, then the join
fleet_after() {
	case $1 in
	start | join) ;;
	*) return 0 ;;
	esac
	if ! helper=$(fleet_helper); then
		printf 'workstation: the fleet helper did not build — run later: workstation fleet\n'
		return 0
	fi
	if ! "$helper/bin/workstation-fleet" online; then
		if command -v whiptail >/dev/null 2>&1 && whiptail --title ' workstation fleet ' \
			--yes-button 'Log in' --no-button 'Later' --yesno \
			"This machine is not logged into tailscale yet.\n\nLog in now? tailscale shows a login URL." 11 70; then
			"$helper/bin/workstation-fleet" login || true
		fi
		if ! "$helper/bin/workstation-fleet" online; then
			printf 'workstation: the fleet waits on tailscale — log in (tailscale up), then: workstation fleet\n'
			return 0
		fi
	fi
	case $1 in
	start)
		printf 'workstation: this machine starts the fleet — on the next machine, run the one-line install and choose Join\n'
		;;
	join)
		"$helper/bin/workstation-fleet" join ||
			printf 'workstation: the join paired part of the fleet or none — re-run: workstation fleet\n'
		;;
	esac
}

flake=""
while [ $# -gt 0 ]; do
	case "$1" in
	--flake)
		[ $# -ge 2 ] || die '--flake needs a PATH argument' 2
		flake=$2
		shift 2
		;;
	--flake=*)
		flake=${1#--flake=}
		shift
		;;
	help|-h|--help)
		usage
		exit 0
		;;
	--version)
		printf '%s\n' 'workstation — nixpkgs-native substrate (reads: nix eval; writes: workstation-switch)'
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		die "unknown option $1 (see: workstation help)" 2
		;;
	*)
		break
		;;
	esac
done

verb=${1:-}
if [ -n "$verb" ]; then
	shift
fi

# the checkout: explicit, then the enclosing checkout, then the recorded one
if [ -z "$flake" ] && [ -n "${WORKSTATION_FLAKE:-}" ]; then
	flake=$WORKSTATION_FLAKE
fi
if [ -z "$flake" ]; then
	dir=$PWD
	links=0
	while :; do
		if [ -f "$dir/flake.nix" ]; then
			flake=$dir
			break
		fi
		[ "$dir" != / ] || break
		parent=$(CDPATH='' cd -P "$dir/.." 2>/dev/null && pwd -P) || break
		[ "$parent" != "$dir" ] || break
		dir=$parent
		links=$((links + 1))
		[ "$links" -le 64 ] || die 'walked too far up looking for flake.nix' 1
	done
fi
if [ -z "$flake" ] && [ -n "${WORKSTATION_CHECKOUT:-}" ] && [ -f "$WORKSTATION_CHECKOUT/flake.nix" ]; then
	flake=$WORKSTATION_CHECKOUT
fi

# the build ref: the committed HEAD, so work in progress stays out of the
# generation; the machine files ride the machine-files input from hosts/local
ref=$flake
mdir=
if [ -n "$flake" ] && [ -d "$flake" ]; then
	flake=$(CDPATH='' cd -P "$flake" && pwd -P)
	ref=$flake
	if [ -z "${WORKSTATION_WORKTREE:-}" ] && command -v git >/dev/null 2>&1 &&
		[ "$(git -C "$flake" rev-parse --show-toplevel 2>/dev/null)" = "$flake" ] &&
		head=$(git -C "$flake" rev-parse --verify -q HEAD 2>/dev/null); then
		ref="git+file://$flake?rev=$head"
	fi
	[ ! -f "$flake/hosts/local/machine.json" ] || mdir=$flake/hosts/local
fi
machine=${flake:+$flake/hosts/local/machine.json}

# the driver builds what the reads read; an operator-set
# WORKSTATION_SWITCH_FLAKE wins
switch_flake() {
	[ -n "$flake" ] || return 0
	export WORKSTATION_SWITCH_CHECKOUT="$flake"
	[ -z "${WORKSTATION_SWITCH_FLAKE:-}" ] || return 0
	[ -f "$machine" ] && [ -f "$flake/bin/workstation" ] || return 0
	export WORKSTATION_SWITCH_FLAKE="$ref"
	export WORKSTATION_SWITCH_MACHINE="$mdir"
}

# uncaptured_checkout — a workstation checkout whose machine is not captured
uncaptured_checkout() {
	[ -n "$flake" ] || return 1
	if [ -f "$machine" ]; then uncaptured "$machine"; else [ -f "$flake/bin/workstation" ]; fi
}

# seed_local — hosts/local from hosts/template, the files absent there
seed_local() {
	for f in machine.json peers.nix; do
		[ ! -f "$flake/hosts/local/$f" ] || continue
		[ -f "$flake/hosts/template/$f" ] || die "init: $flake/hosts/template/$f missing (unexpected tree)" 1
		mkdir -p "$flake/hosts/local" && cp "$flake/hosts/template/$f" "$flake/hosts/local/$f"
	done
}

# writable_machine <verb> — the checkout's machine file, editable
writable_machine() {
	[ -n "$flake" ] || die 'no checkout found — run inside the workstation repo clone' 2
	[ -f "$machine" ] || die 'machine not captured — run: workstation init' 2
	[ -w "$machine" ] ||
		die "$1: $machine is read-only — run inside the workstation repo clone" 2
}

case "$verb" in
init | setup)
	# capture once: a field the file already sets wins; the placeholders
	# (TEMPLATE, /home/TEMPLATE) and absent fields are asked and filled.
	# setup re-asks every dialog with the current answer prefilled.
	reask=0
	[ "$verb" = setup ] && reask=1
	[ -n "$flake" ] || die 'no checkout found — run inside the workstation repo clone' 2
	seed_local
	writable_machine init
	host=$(uname -n 2>/dev/null)
	host=${host%%.*}
	user=${USER:-$(id -un)}
	home_dir=$HOME
	case "$(uname -m)" in
	arm64 | aarch64) arch=aarch64 ;;
	*) arch=x86_64 ;;
	esac
	case "$(uname -s)" in
	Darwin) system=$arch-darwin ;;
	*) system=$arch-linux ;;
	esac
	if command -v whiptail >/dev/null 2>&1; then
		ask() {
			whiptail --title ' workstation init ' --inputbox "$1" 9 68 "$2" \
				3>&1 1>&2 2>&3
		}
	else
		printf 'workstation: whiptail not on PATH — capturing the detected values verbatim\n' >&2
		ask() {
			printf '%s' "$2"
		}
	fi
	changed=0
	# capture_field <key> <prompt> <detected>
	capture_field() {
		cur=$(jqx -r --arg k "$1" '.[$k] // "" | tostring' "$machine")
		prefill=$3
		case $cur in
		"" | TEMPLATE | "/home/TEMPLATE") ;;
		*)
			[ "$reask" = 1 ] || return 0
			prefill=$cur
			;;
		esac
		val=$(ask "$2" "$prefill") || die 'init: cancelled' 1
		machine_edit '.[$k] = $v' --arg k "$1" --arg v "$val"
		changed=1
	}

	# the language members the report offers, as a checklist carrying the
	# machine's current selection; a member turned off by the checklist
	# returns to its default (the flag key leaves)
	langs_step() {
		command -v whiptail >/dev/null 2>&1 || {
			printf 'workstation: languages unchanged (whiptail absent) — workstation add languages/<name>\n' >&2
			return 0
		}
		rows=$(nix_eval "$ref#workstation.report.selectable" 2>/dev/null) || rows=
		members=$(printf '%s' "$rows" |
			jqx -r 'to_entries | map(select((.key | startswith("languages/")) and (.value.kind == "member")) | .key | ltrimstr("languages/")) | .[]' 2>/dev/null) ||
			members=
		[ -n "$members" ] || return 0
		set --
		for name in $members; do
			if [ "$(jqx -r --arg n "$name" '.settings.workstation.languages[$n].enable // false' "$machine")" = true ]; then
				set -- "$@" "$name" '' on
			else
				set -- "$@" "$name" '' off
			fi
		done
		sel=$(whiptail --title " workstation $verb " --checklist \
			'Languages to include on this machine' 14 60 5 "$@" \
			3>&1 1>&2 2>&3) || die "$verb: cancelled" 1
		sel=$(printf '%s' "$sel" | tr -d '"')
		for name in $members; do
			cur=$(jqx -r --arg n "$name" '.settings.workstation.languages[$n].enable // false' "$machine")
			case " $sel " in
			*" $name "*)
				[ "$cur" = true ] ||
					{ machine_edit '.settings.workstation.languages[$n].enable = true' --arg n "$name"; changed=1; }
				;;
			*)
				if [ "$cur" = true ]; then
					machine_edit 'del(.settings.workstation.languages[$n])' --arg n "$name"
					changed=1
				fi
				;;
			esac
		done
		printf 'workstation: languages: %s\n' "${sel:-none}"
	}
	capture_field host 'machine name (hostname)' "$host"
	capture_field user 'operator user' "$user"
	capture_field home 'home directory' "$home_dir"
	if [ -z "$(jqx -r '.system // ""' "$machine")" ]; then
		machine_edit '.system = $s' --arg s "$system"
	fi
	if [ "$(jqx -r '.checkout // ""' "$machine")" != "$flake" ]; then
		machine_edit '.checkout = $c' --arg c "$flake"
		changed=1
	fi
	if [ "$changed" -eq 1 ]; then
		printf 'workstation: machine captured in %s (host=%s user=%s)\n' \
			"$machine" "$(jqx -r .host "$machine")" "$(jqx -r .user "$machine")"
	else
		printf 'workstation: machine already captured in %s (host=%s user=%s) — the fields you set were kept\n' \
			"$machine" "$(jqx -r .host "$machine")" "$(jqx -r .user "$machine")"
	fi
	langs_step
	fleet_mode=''
	if [ -z "$(fleet_get)" ] || [ "$reask" = 1 ]; then
		fleet_choose 'workstation init'
	fi
	if [ "${WORKSTATION_NO_APPLY:-}" = 1 ]; then
		printf 'workstation: capture done; apply skipped (WORKSTATION_NO_APPLY=1) — next: workstation apply\n'
		exit 0
	fi
	if command -v whiptail >/dev/null 2>&1; then
		if ! whiptail --title ' workstation init ' --yesno \
			'Apply the substrate now (the first switch)?' 9 68; then
			printf 'workstation: capture done; apply deferred — next: workstation apply\n'
			exit 0
		fi
	fi
	key="$(jqx -r .user "$machine")@$(jqx -r .host "$machine")"
	case "$(uname -s)" in
	Darwin)
		printf 'workstation: first activation (darwin plane, %s) ...\n' "$key"
		drv=$(nix --extra-experimental-features 'nix-command flakes' \
			build --no-link --print-out-paths --inputs-from "$flake" \
			nix-darwin#darwin-rebuild)
		sudo env NIX_CONFIG="extra-experimental-features = nix-command flakes" \
			"$drv/bin/darwin-rebuild" switch --flake "$ref#$key" \
			${mdir:+--override-input machine-files "path:$mdir"} ||
			die 'init: the first darwin switch failed' 1
		printf 'workstation: applied — every later update is: workstation apply --system\n'
		fleet_after "$fleet_mode"
		exit 0
		;;
	esac
	printf 'workstation: first activation (home plane, %s) ...\n' "$key"
	store_path=$(nixf build --no-link --print-out-paths \
		"$ref#homeConfigurations.\"$key\".activationPackage")
	"$store_path/activate"
	printf 'workstation: applied — every later update is: workstation apply\n'
	fleet_after "$fleet_mode"
	;;
fleet)
	[ $# -eq 0 ] || die 'fleet takes no arguments' 2
	writable_machine fleet
	if uncaptured "$machine"; then
		die 'machine not captured — run: workstation init' 2
	fi
	command -v whiptail >/dev/null 2>&1 || die 'fleet: the dialogs need whiptail (it ships with the substrate)' 2
	before=$(cksum <"$machine")
	fleet_choose 'workstation fleet'
	if [ "$before" != "$(cksum <"$machine")" ]; then
		command -v workstation-switch >/dev/null 2>&1 ||
			die 'the write plane is the generation'\''s workstation-switch driver and it is not on PATH — apply the substrate first (the home lane stages it)' 2
		switch_flake
		printf 'workstation: the switch serves the fleet choice ...\n'
		case "$(uname -s)" in
		Darwin)
			sudo env NIX_CONFIG="extra-experimental-features = nix-command flakes" \
				WORKSTATION_SWITCH_FLAKE="${WORKSTATION_SWITCH_FLAKE:-}" \
				WORKSTATION_SWITCH_MACHINE="${WORKSTATION_SWITCH_MACHINE:-}" \
				"$(command -v workstation-switch)" apply --system || die 'fleet: the switch failed' 1
			;;
		*) workstation-switch apply || die 'fleet: the switch failed' 1 ;;
		esac
	fi
	fleet_after "$fleet_mode"
	;;
status | plan | capabilities)
	[ -n "$flake" ] ||
		die 'no checkout to read — pass --flake PATH or run inside a checkout' 2
	scope=''
	for arg in "$@"; do
		case "$arg" in
		*[!A-Za-z0-9_./-]*)
			die "invalid scope element: $arg (attribute names only)" 2
			;;
		esac
		scope="$scope.\"$arg\""
	done
	nix_eval "$ref#workstation.report.$verb$scope"
	exit
	;;
selected)
	[ -n "$flake" ] ||
		die 'no checkout to read — pass --flake PATH or run inside a checkout' 2
	[ $# -eq 0 ] || die 'selected takes no arguments' 2
	nix_eval "$ref#workstation.report.selections"
	exit
	;;
add | remove)
	[ $# -ge 1 ] || die "usage: workstation $verb <path>... (see: workstation help)" 2
	writable_machine selections
	changed=0
	for path do
		case $path in
		*[!A-Za-z0-9_/-]* | "" | /* | */ | */*/*)
			die "invalid path: $path (the grammar is <domain> or <domain>/<member>, [A-Za-z0-9_-] only)" 2
			;;
		esac
		row=$(nix_eval "$ref#workstation.report.selectable.\"$path\"") ||
			die "unknown path: $path (workstation selected lists the valid paths)" 2
		if printf '%s' "$row" | grep -q '"baseline":true'; then
			die "$path is baseline — always on" 2
		fi
		keys=$(printf '%s' "$path" | jqx -Rc 'split("/")')
		cur=$(jqx -r --argjson p "$keys" '.settings.workstation | getpath($p + ["enable"]) | if . == null then "unset" else tostring end' "$machine")
		if [ "$verb" = add ]; then
			if [ "$cur" = true ]; then
				printf 'workstation: %s already selected\n' "$path"
				continue
			fi
			machine_edit '.settings.workstation |= (setpath($p + ["enable"]; true)
				| if ($p | length) == 2 and getpath([$p[0], "enable"]) == false
				  then setpath([$p[0], "enable"]; true) else . end)' --argjson p "$keys"
			changed=1
			printf 'workstation: %s selected\n' "$path"
		else
			if printf '%s' "$row" | grep -q '"default":true'; then
				default_on=yes
			else
				default_on=no
			fi
			if [ "$cur" = false ]; then
				printf 'workstation: %s already off\n' "$path"
			elif [ "$cur" = true ] && [ "$default_on" = no ]; then
				machine_edit '.settings.workstation |= delpaths([$p + ["enable"]])' --argjson p "$keys"
				changed=1
				printf 'workstation: %s removed\n' "$path"
			elif [ "$default_on" = yes ]; then
				machine_edit '.settings.workstation |= setpath($p + ["enable"]; false)' --argjson p "$keys"
				changed=1
				printf 'workstation: %s removed\n' "$path"
			else
				printf 'workstation: %s already off (never selected)\n' "$path"
			fi
		fi
	done
	if [ "$changed" = 1 ]; then
		machine_edit 'def prune: if type == "object" then with_entries(.value |= prune) | with_entries(select(.value != {})) else . end;
			.settings |= prune'
		printf 'workstation: selection saved in %s\n' "$machine"
		offer_apply
	else
		printf 'workstation: selection unchanged\n'
	fi
	;;
peers)
	[ $# -eq 0 ] || die 'peers takes no arguments' 2
	[ -n "$flake" ] ||
		die 'no checkout found — run inside the workstation repo clone' 2
	peers_file=$flake/hosts/local/peers.nix
	[ -f "$peers_file" ] || die "peers: $peers_file missing — run: workstation init" 1
	[ -w "$peers_file" ] ||
		die "peers: $peers_file is read-only — run inside the workstation repo clone" 2
	helper=$(peers_helper) || die 'peers: the discovery helper did not build (nix build failed)' 1
	# the helper's exit: 0 nothing to apply, 10 saved, anything else a failure
	before=$(cksum <"$peers_file")
	rc=0
	"$helper/bin/workstation-peers" "$peers_file" || rc=$?
	case $rc in
	0 | 10) ;;
	*) exit "$rc" ;;
	esac
	if [ "$rc" = 10 ] || [ "$before" != "$(cksum <"$peers_file")" ]; then
		offer_apply peers
	fi
	;;
apply | rollback | update | sync)
	# writes refuse until init captured the machine
	if uncaptured_checkout; then
		die 'machine not captured — run: workstation init' 2
	fi
	if command -v workstation-switch >/dev/null 2>&1; then
		switch_flake
		exec workstation-switch "$verb" "$@"
	fi
	die 'the write plane is the generation'\''s workstation-switch driver and it is not on PATH — apply the substrate first (the home lane stages it)' 2
	;;
'')
	usage
	exit 0
	;;
*)
	[ "$verb" = help ] && {
		usage
		exit 0
	}
	printf "workstation: unknown verb '%s' (see: workstation help)\n" "$verb" >&2
	exit 2
	;;
esac
