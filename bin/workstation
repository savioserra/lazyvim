#!/bin/sh
# The workstation launcher: the nix substrate's whole client. Reads are
# nix evals over the flake's declared-state report
# (#workstation.report.<verb> — the capability modules' fold, nix/report.nix);
# the write plane is the generation's workstation-switch driver.
set -eu

usage() {
	cat <<'EOF'
workstation — the nixpkgs-native workstation substrate

install (once per machine):
  init            capture this machine's identity into hosts/identity.nix
                  (whiptail dialogs prefilled with the detected values) and
                  run the first activation — the whole install is:
                    clone && workstation init
                  keep the identity file uncommitted; every later update is
                  `workstation apply` (WORKSTATION_NO_APPLY=1 skips the
                  first switch)

reads (the declared state, answered by nix eval over
#workstation.report.<verb>):
  status          the declared inventory: counts, capability order
  plan            the declared surface the next switch applies
  capabilities    the per-capability declared surface
                  (scope with an attrpath: workstation capabilities editor)

write plane (the generation's workstation-switch driver):
  apply|rollback|update|sync [--system]

other:
  help            this text

The read flake resolves in this order: --flake PATH, $WORKSTATION_FLAKE,
the enclosing checkout (the first flake.nix walking up from $PWD), the
staged generation snapshot (~/.local/opt/workstation/flake — the home
lane stages it at every switch).
EOF
}

die() {
	printf 'workstation: %s\n' "$1" >&2
	exit "${2:-1}"
}

flake=""
while [ $# -gt 0 ]; do
	case "$1" in
	--flake)
		[ $# -ge 2 ] || die '--flake needs a PATH argument' 2
		flake=$2
		shift 2
		;;
	--flake=*)
		flake=${1#--flake=}
		shift
		;;
	help|-h|--help)
		usage
		exit 0
		;;
	--version)
		printf '%s\n' 'workstation — nixpkgs-native substrate (reads: nix eval; writes: workstation-switch)'
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		die "unknown option $1 (see: workstation help)" 2
		;;
	*)
		break
		;;
	esac
done

verb=${1:-}
if [ -n "$verb" ]; then
	shift
fi

# The read flake: explicit, then the enclosing checkout, then the staged
# generation snapshot. A bare host with neither fails closed with the fix
# named — the substrate has no embedded fallback to misread.
if [ -z "$flake" ] && [ -n "${WORKSTATION_FLAKE:-}" ]; then
	flake=$WORKSTATION_FLAKE
fi
if [ -z "$flake" ]; then
	dir=$PWD
	links=0
	while :; do
		if [ -f "$dir/flake.nix" ]; then
			flake=$dir
			break
		fi
		[ "$dir" != / ] || break
		parent=$(CDPATH='' cd -P "$dir/.." 2>/dev/null && pwd -P) || break
		[ "$parent" != "$dir" ] || break
		dir=$parent
		links=$((links + 1))
		[ "$links" -le 64 ] || die 'walked too far up looking for flake.nix' 1
	done
fi
if [ -z "$flake" ] && [ -e "${HOME:?}/.local/opt/workstation/flake" ]; then
	flake=$HOME/.local/opt/workstation/flake
fi

case "$verb" in
init)
	# Capture this machine's identity once, at install time. The template
	# file hosts/identity.nix is rewritten in the working copy; the local
	# edit stays uncommitted (the repo carries no personal strings at
	# HEAD — evals read the dirty tree).
	[ -n "$flake" ] || die 'init: no checkout found — run inside the workstation repo clone' 2
	[ -f "$flake/hosts/identity.nix" ] || die "init: $flake/hosts/identity.nix missing (unexpected tree)" 1
	host=$(hostname -s 2>/dev/null || hostname)
	user=${USER:-$(id -un)}
	home_dir=$HOME
	# nix-string escape (backslash, quote) — the capture writes a nix file
	escape() {
		printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
	}
	# The capture UI: whiptail dialogs prefilled with the detected values
	# (the prerequisite ships in foundation; a bare box before its first
	# switch falls back to the detected values verbatim).
	if command -v whiptail >/dev/null 2>&1; then
		ask() {
			# ask <title> <default> — the value on stdout (whiptail writes
			# the dialog to stderr; the fd swap brings the value back)
			whiptail --title ' workstation init ' --inputbox "$1" 9 68 "$2" \
				3>&1 1>&2 2>&3
		}
		host=$(ask 'machine name (hostname)' "$host") || die 'init: cancelled' 1
		user=$(ask 'operator user' "$user") || die 'init: cancelled' 1
		home_dir=$(ask 'home directory' "$home_dir") || die 'init: cancelled' 1
	else
		printf 'workstation: whiptail not on PATH (prerequisite) — capturing the detected values verbatim\n' >&2
	fi
	{
		printf '# The machine identity, captured by workstation init (%s).\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
		printf '# Local edit — keep it uncommitted (the committed copy is the template).\n'
		printf '{\n'
		printf '  host = "%s";\n' "$(escape "$host")"
		printf '  user = "%s";\n' "$(escape "$user")"
		printf '  home = "%s";\n' "$(escape "$home_dir")"
		printf '}\n'
	} >"$flake/hosts/identity.nix"
	printf 'workstation: identity captured in %s/hosts/identity.nix (host=%s user=%s)\n' \
		"$flake" "$host" "$user"
	printf 'workstation: keep the file uncommitted\n'
	# The first activation rides init: one command per machine, the
	# leg-native switch stays inside the shim (users never type it). The
	# homeConfiguration's activationPackage is built from THIS flake — the
	# flake's own pinned home-manager, never a stray CLI. After this switch
	# the staged driver exists and `workstation apply` owns every later one.
	if [ "${WORKSTATION_NO_APPLY:-}" = 1 ]; then
		printf 'workstation: capture done; apply skipped (WORKSTATION_NO_APPLY=1) — next: workstation apply\n'
		exit 0
	fi
	if command -v whiptail >/dev/null 2>&1; then
		if ! whiptail --title ' workstation init ' --yesno \
			'Apply the substrate now (the first switch)?' 9 68; then
			printf 'workstation: capture done; apply deferred — next: workstation apply\n'
			exit 0
		fi
	fi
	key="$user@$host"
	if command -v darwin-rebuild >/dev/null 2>&1; then
		die 'the mac first switch bootstraps nix-darwin itself — see docs/testing.md (the leg-native bootstrap); this shim owns it after the first switch' 2
	fi
	printf 'workstation: first activation (home plane, %s) ...\n' "$key"
	nix --extra-experimental-features 'nix-command flakes' \
		build --no-link --print-build-logs \
		"$flake#homeConfigurations.$key.activationPackage"
	# the activation package lands in the store; run its activate
	store_path=$(nix --extra-experimental-features 'nix-command flakes' \
		eval --raw "$flake#homeConfigurations.$key.activationPackage")
	"$store_path/activate"
	printf 'workstation: applied — every later update is: workstation apply\n'
	;;
status | plan | capabilities)
	[ -n "$flake" ] ||
		die 'no flake to read — pass --flake PATH, run inside a checkout, or apply the substrate once (it stages ~/.local/opt/workstation/flake)' 2
	# optional attrpath scope: `workstation capabilities editor` reads
	# #workstation.report.capabilities.editor — every element must be a
	# plain attribute name (never shell-interpreted, never an eval escape)
	scope=''
	for arg in "$@"; do
		case "$arg" in
		*[!A-Za-z0-9_.-]*)
			die "invalid scope element: $arg (attribute names only)" 2
			;;
		esac
		scope="$scope.$arg"
	done
	exec nix --extra-experimental-features 'nix-command flakes' \
		eval --json "$flake#workstation.report.$verb$scope"
	;;
apply | rollback | update | sync)
	# The identity gate: writes refuse until `workstation init` captured
	# this machine's identity — switching the bare template would create a
	# TEMPLATE user's home on a real machine.
	if [ -n "$flake" ] && [ -f "$flake/hosts/identity.nix" ] &&
		grep -q '"TEMPLATE"' "$flake/hosts/identity.nix"; then
		die 'identity not captured — run: workstation init' 2
	fi
	if command -v workstation-switch >/dev/null 2>&1; then
		exec workstation-switch "$verb" "$@"
	fi
	die 'the write plane is the generation'\''s workstation-switch driver and it is not on PATH — apply the substrate first (the home lane stages it)' 2
	;;
'')
	usage
	exit 0
	;;
*)
	[ "$verb" = help ] && {
		usage
		exit 0
	}
	printf "workstation: unknown verb '%s' (see: workstation help)\n" "$verb" >&2
	exit 2
	;;
esac
