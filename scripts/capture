#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
REPO_ROOT="$(repo_root)"
# shellcheck source=../manifests/tools.env
source "$REPO_ROOT/manifests/tools.env"

opt_home="${DOTFILES_OPT_HOME:-$HOME/.local/opt}"
bin_home="${DOTFILES_BIN_HOME:-$HOME/.local/bin}"
chezmoi="${CHEZMOI_BIN:-$bin_home/chezmoi}"
[[ -x "$chezmoi" ]] || chezmoi="$opt_home/chezmoi-$CHEZMOI_VERSION/chezmoi"
[[ -x "$chezmoi" ]] || die "pinned chezmoi is not installed; run scripts/install first"

log "Capturing managed configuration changes"
"$chezmoi" --source "$REPO_ROOT" --destination "$HOME" re-add "$@"
log "Capture complete; review the repository diff before committing"
