#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
REPO_ROOT="$(repo_root)"

require_command git
lockfile="$REPO_ROOT/manifests/tmux-plugins.lock"
plugin_root="${TMUX_PLUGIN_HOME:-$HOME/.tmux/plugins}"
temporary=""

cleanup() {
  if [[ -n "$temporary" && -e "$temporary" ]]; then
    rm -rf "$temporary"
  fi
}
trap cleanup EXIT HUP INT TERM

[[ -f "$lockfile" ]] || die "tmux plugin lockfile is missing: $lockfile"
mkdir -p "$plugin_root"

while IFS='|' read -r name repository revision; do
  [[ -n "$name" && "$name" != \#* ]] || continue
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid tmux plugin name: $name"
  [[ "$repository" == https://github.com/*.git ]] || die "invalid tmux plugin repository for $name"
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || die "invalid tmux plugin revision for $name"

  target="$plugin_root/$name"
  if [[ -e "$target" ]]; then
    [[ -d "$target/.git" ]] || die "$target exists but is not a Git checkout"
    [[ -z "$(git -C "$target" status --porcelain)" ]] \
      || die "$name has local changes; preserve or discard them before restoring"
    if ! git -C "$target" cat-file -e "${revision}^{commit}" 2>/dev/null; then
      log "Fetching locked tmux plugin: $name"
      git -C "$target" fetch --quiet "$repository" "$revision"
    fi
  else
    log "Cloning locked tmux plugin: $name"
    temporary="$plugin_root/.${name}.tmp.$$"
    git clone --quiet --no-checkout "$repository" "$temporary"
    git -C "$temporary" checkout --quiet --detach "$revision"
    mv "$temporary" "$target"
    temporary=""
  fi

  git -C "$target" checkout --quiet --detach --force "$revision"
  actual_revision="$(git -C "$target" rev-parse HEAD)"
  [[ "$actual_revision" == "$revision" ]] || die "$name did not restore to $revision"
  log "Restored tmux plugin: $name ${revision:0:12}"
done <"$lockfile"

if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  tmux source-file "$HOME/.tmux.conf"
  log "Reloaded tmux2k in the active tmux server"
fi

log "tmux plugins match manifests/tmux-plugins.lock"
