#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
REPO_ROOT="$(repo_root)"
NVIM_BIN="${NVIM_BIN:-$REPO_ROOT/packages/bin/nvim}"

require_command git
require_command jq
[[ -z "$(git -C "$REPO_ROOT" status --porcelain)" ]] \
  || die "commit or stash repository changes before updating"

log "Updating plugins and lazy-lock.json"
"$NVIM_BIN" --headless "+Lazy! sync" +qa

mapfile -t mason_packages < <(jq -r 'keys[]' "$REPO_ROOT/packages/nvim/mason-lock.json")
if ((${#mason_packages[@]})); then
  log "Updating ${#mason_packages[@]} Mason packages"
  "$NVIM_BIN" --headless \
    "+Lazy load mason.nvim" \
    "+MasonInstall --force --strict ${mason_packages[*]}" \
    +qa
  "$REPO_ROOT/scripts/lock-mason"
fi

log "Updating installed Tree-sitter parsers"
"$NVIM_BIN" --headless \
  "+Lazy load nvim-treesitter" \
  "+lua assert(require('nvim-treesitter').update(nil, { summary = true }):wait())" \
  +qa

"$REPO_ROOT/scripts/check"
log "Update complete; review and commit the lockfile changes"
