#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
case "$(uname -s)" in
  Linux) exec "$script_dir/install-linux" "$@" ;;
  Darwin) exec "$script_dir/install-macos" "$@" ;;
  MINGW* | MSYS* | CYGWIN*)
    printf 'error: run scripts/install-windows.ps1 from PowerShell on Windows\n' >&2
    exit 1
    ;;
  *)
    printf 'error: unsupported operating system: %s\n' "$(uname -s)" >&2
    exit 1
    ;;
esac
