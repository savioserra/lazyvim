#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
REPO_ROOT="$(repo_root)"
# shellcheck source=../manifests/tools.env
source "$REPO_ROOT/manifests/tools.env"
NVIM_BIN="${NVIM_BIN:-$REPO_ROOT/packages/bin/nvim}"

require_command jq
require_command bash

log "Checking shell syntax"
while IFS= read -r file; do
  bash -n "$file"
done < <(
  find "$REPO_ROOT/scripts" "$REPO_ROOT/packages/bin" \
    -type f \( -name '*.sh' -o -perm -111 \) -print | LC_ALL=C sort
)

log "Checking JSON files"
while IFS= read -r file; do
  jq empty "$file"
done < <(find "$REPO_ROOT/home/dot_config/nvim" -type f -name '*.json' -print | sort)

log "Checking pinned Neovim"
actual_nvim_version="$($NVIM_BIN --version | awk 'NR == 1 { sub(/^NVIM v/, ""); print }')"
[[ "$actual_nvim_version" == "$NEOVIM_VERSION" ]] \
  || die "expected Neovim $NEOVIM_VERSION, found $actual_nvim_version"

bin_home="${DOTFILES_BIN_HOME:-$HOME/.local/bin}"
chezmoi="$bin_home/chezmoi"
[[ -x "$chezmoi" ]] || die "managed chezmoi is missing: $chezmoi"
"$chezmoi" --version | grep -F "chezmoi version v${CHEZMOI_VERSION}," >/dev/null \
  || die "chezmoi does not match version $CHEZMOI_VERSION"

log "Checking chezmoi source and target state"
chezmoi_diff="$("$chezmoi" --source "$REPO_ROOT" --destination "$HOME" --no-pager diff)"
[[ -z "$chezmoi_diff" ]] \
  || die "managed configuration differs from the repository; run scripts/capture or scripts/apply"

log "Checking companion tool versions"
for command in rg fd fzf lazygit tree-sitter; do
  [[ -x "$bin_home/$command" ]] || die "managed companion tool is missing: $bin_home/$command"
done

case "$(uname -s):$(uname -m)" in
  Linux:x86_64) expected_fd_version="$FD_LINUX_X86_64_VERSION" ;;
  Darwin:arm64) expected_fd_version="$FD_DARWIN_ARM64_VERSION" ;;
  Darwin:x86_64) expected_fd_version="$FD_DARWIN_X86_64_VERSION" ;;
  *) die "unsupported check platform: $(uname -s) $(uname -m)" ;;
esac

rg_version="$("$bin_home/rg" --version | awk 'NR == 1 { print }')"
[[ "$rg_version" == "ripgrep $RIPGREP_VERSION"* ]] \
  || die "ripgrep does not match version $RIPGREP_VERSION"
[[ "$("$bin_home/fd" --version)" == "fd $expected_fd_version" ]] \
  || die "fd does not match version $expected_fd_version"
"$bin_home/fzf" --version | grep -E "^${FZF_VERSION}( |$)" >/dev/null \
  || die "fzf does not match version $FZF_VERSION"
"$bin_home/lazygit" --version | grep -E "version=${LAZYGIT_VERSION}(,|$)" >/dev/null \
  || die "lazygit does not match version $LAZYGIT_VERSION"
[[ "$("$bin_home/tree-sitter" --version)" == "tree-sitter $TREE_SITTER_VERSION" ]] \
  || die "tree-sitter does not match version $TREE_SITTER_VERSION"

config_target="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
[[ -d "$config_target" ]] || die "managed Neovim configuration is missing: $config_target"

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
case "$data_home" in
  "$HOME"/snap/code/*/.local/share) data_home="$HOME/.local/share" ;;
esac
stylua="$data_home/nvim/mason/bin/stylua"
if [[ -x "$stylua" ]]; then
  log "Checking Lua formatting"
  "$stylua" --check "$REPO_ROOT/home/dot_config/nvim/lua"
else
  warn "Stylua is not installed; skipping Lua formatting check"
fi

mason_dir="$data_home/nvim/mason/packages"
if [[ -d "$mason_dir" ]]; then
  log "Checking installed Mason versions"
  while IFS=$'\t' read -r package expected; do
    receipt="$mason_dir/$package/mason-receipt.json"
    [[ -f "$receipt" ]] || continue
    actual="$(mason_receipt_version "$receipt")"
    [[ "$actual" == "$expected" ]] \
      || die "Mason package $package is $actual; lockfile requires $expected"
  done < <(jq -r 'to_entries[] | [.key, .value] | @tsv' "$REPO_ROOT/home/dot_config/nvim/mason-lock.json")
fi

if command -v tmux >/dev/null 2>&1; then
  log "Checking tmux configuration"
  tmux_socket="dotfiles-check-$$"
  trap 'TMUX="" tmux -L "$tmux_socket" kill-server >/dev/null 2>&1 || true' EXIT
  TMUX='' tmux -L "$tmux_socket" -f "$HOME/.tmux.conf" new-session -d -s dotfiles-check
  [[ "$(TMUX='' tmux -L "$tmux_socket" show-options -gqv mouse)" == "on" ]] \
    || die "tmux mouse support is not enabled"
  [[ "$(TMUX='' tmux -L "$tmux_socket" show-options -sqv escape-time)" == "10" ]] \
    || die "tmux escape-time is not 10ms"
  [[ "$(TMUX='' tmux -L "$tmux_socket" show-options -gqv focus-events)" == "on" ]] \
    || die "tmux focus events are not enabled"
  [[ "$(TMUX='' tmux -L "$tmux_socket" show-options -gqv default-terminal)" == "tmux-256color" ]] \
    || die "tmux default terminal is not tmux-256color"
  [[ "$(TMUX='' tmux -L "$tmux_socket" show-options -sqv 'terminal-features[100]')" == "xterm-256color:RGB" ]] \
    || die "tmux true-color support is not configured"
  TMUX='' tmux -L "$tmux_socket" kill-server
  trap - EXIT
else
  warn "tmux is not installed; skipping tmux configuration check"
fi

log "Checking headless startup"
"$NVIM_BIN" --headless \
  "+lua assert(vim.g.lazyvim_ts_lsp == 'vtsls', 'LazyVim options were not loaded')" \
  +qa

log "All checks passed"
