#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
REPO_ROOT="$(repo_root)"
require_command jq

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
case "$data_home" in
  "$HOME"/snap/code/*/.local/share) data_home="$HOME/.local/share" ;;
esac
packages_dir="$data_home/nvim/mason/packages"
[[ -d "$packages_dir" ]] || die "Mason package directory does not exist: $packages_dir"

entries="$(mktemp)"
output="$(mktemp)"
trap 'rm -f "$entries" "$output"' EXIT

for receipt in "$packages_dir"/*/mason-receipt.json; do
  [[ -f "$receipt" ]] || continue
  package="$(jq -er '.name' "$receipt")" || die "invalid Mason receipt: $receipt"
  version="$(mason_receipt_version "$receipt")" || die "could not determine version from: $receipt"
  printf '%s\t%s\n' "$package" "$version" >>"$entries"
done

[[ -s "$entries" ]] || die "no installed Mason packages found"
LC_ALL=C sort -o "$entries" "$entries"
jq -Rn '
  reduce inputs as $line ({};
    ($line | split("\t")) as $entry
    | . + {($entry[0]): $entry[1]}
  )
' <"$entries" >"$output"

mv "$output" "$REPO_ROOT/packages/nvim/mason-lock.json"
log "Locked $(wc -l <"$entries") Mason packages in packages/nvim/mason-lock.json"
