#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
REPO_ROOT="$(repo_root)"
# shellcheck source=../manifests/tools.env
source "$REPO_ROOT/manifests/tools.env"
require_command git

bin_home="${DOTFILES_BIN_HOME:-$HOME/.local/bin}"
chezmoi="${CHEZMOI_BIN:-$bin_home/chezmoi}"
[[ -x "$chezmoi" ]] || chezmoi="${DOTFILES_OPT_HOME:-$HOME/.local/opt}/chezmoi-$CHEZMOI_VERSION/chezmoi"
[[ -x "$chezmoi" ]] || die "pinned chezmoi is not installed; run scripts/install first"
[[ -z "$("$chezmoi" --source "$REPO_ROOT" --destination "$HOME" --no-pager diff)" ]] \
  || die "capture or apply managed configuration changes before syncing"

[[ -z "$(git -C "$REPO_ROOT" status --porcelain)" ]] \
  || die "commit or stash repository changes before syncing"

if git -C "$REPO_ROOT" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
  log "Pulling configuration changes"
  git -C "$REPO_ROOT" pull --ff-only
else
  warn "no upstream branch is configured; skipping git pull"
fi

"$REPO_ROOT/scripts/install" --no-restore
"$REPO_ROOT/scripts/restore"
"$REPO_ROOT/scripts/check"
log "Sync complete"
