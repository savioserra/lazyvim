#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=lib/common.sh
source "$script_dir/lib/common.sh"
REPO_ROOT="$(repo_root)"

restore_plugins=true
restore_mason=true
restore_parsers=true

usage() {
  cat <<'EOF'
Usage: scripts/restore [options]

Restore the editor from the committed lockfiles.

Options:
  --plugins-only  Restore lazy.nvim plugins only
  --mason-only    Restore Mason packages only
  --skip-parsers  Do not install missing Tree-sitter parsers
  -h, --help      Show this help
EOF
}

while (($#)); do
  case "$1" in
    --plugins-only)
      restore_mason=false
      restore_parsers=false
      ;;
    --mason-only)
      restore_plugins=false
      restore_parsers=false
      ;;
    --skip-parsers) restore_parsers=false ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      die "unknown option: $1"
      ;;
  esac
  shift
done

"$REPO_ROOT/scripts/apply"

NVIM_BIN="${NVIM_BIN:-$REPO_ROOT/packages/bin/nvim}"
[[ -x "$NVIM_BIN" ]] || die "Neovim wrapper is not executable: $NVIM_BIN"
"$NVIM_BIN" --version >/dev/null 2>&1 || die "pinned Neovim is not installed; run scripts/install first"

if $restore_plugins; then
  log "Restoring plugins from lazy-lock.json"
  "$NVIM_BIN" --headless "+Lazy! restore" +qa
fi

if $restore_mason; then
  require_command jq
  lockfile="$REPO_ROOT/home/dot_config/nvim/mason-lock.json"
  data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
  case "$data_home" in
    "$HOME"/snap/code/*/.local/share) data_home="$HOME/.local/share" ;;
  esac
  mason_packages="$data_home/nvim/mason/packages"
  specs=()

  while IFS=$'\t' read -r package version; do
    receipt="$mason_packages/$package/mason-receipt.json"
    installed_version=""
    if [[ -f "$receipt" ]]; then
      installed_version="$(mason_receipt_version "$receipt" 2>/dev/null || true)"
    fi
    if [[ "$installed_version" != "$version" ]]; then
      specs+=("$package@$version")
    fi
  done < <(jq -r 'to_entries[] | [.key, .value] | @tsv' "$lockfile")

  if ((${#specs[@]})); then
    log "Restoring ${#specs[@]} Mason package(s) from mason-lock.json"
    "$NVIM_BIN" --headless \
      "+Lazy load mason.nvim" \
      "+MasonInstall --force --strict ${specs[*]}" \
      +qa
  else
    log "Mason packages already match mason-lock.json"
  fi
fi

if $restore_parsers; then
  log "Installing missing Tree-sitter parsers"
  "$NVIM_BIN" --headless \
    "+Lazy load nvim-treesitter" \
    "+lua require('dotfiles.restore').parsers()" \
    +qa
fi

log "Restore complete"
