#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(
  CDPATH=''
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
  pwd -P
)"
target_home="${CHEZMOI_DESTDIR:-$HOME}"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'sync: required command not found: %s\n' "$1" >&2
    exit 127
  fi
}

run_step() {
  local description="$1"
  shift
  printf '\n==> %s\n' "$description"
  "$@"
}

require_command chezmoi

if [[ "${CHEZMOI_SYNC_APPLY_ONLY:-0}" == 1 ]]; then
  run_step "Applying checked-out chezmoi source state" \
    chezmoi --source "$repo_root" --destination "$target_home" apply --force
else
  run_step "Pulling and applying chezmoi source state" \
    chezmoi --source "$repo_root" --destination "$target_home" update --force
fi

nvim="$target_home/.local/opt/nvim/bin/nvim"
if [[ ! -x "$nvim" ]]; then
  printf 'sync: managed Neovim not found: %s\n' "$nvim" >&2
  exit 127
fi

run_step "Running Lua capability sync" \
  "$nvim" -l "$target_home/.local/share/lazyvim/run.lua" sync
