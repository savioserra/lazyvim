#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(
  CDPATH=''
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
  pwd -P
)"
target_home="${CHEZMOI_DESTDIR:-$HOME}"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'sync: required command not found: %s\n' "$1" >&2
    exit 127
  fi
}

run_step() {
  local description="$1"
  shift
  printf '\n==> %s\n' "$description"
  "$@"
}

require_command chezmoi

if [[ "${CHEZMOI_SYNC_APPLY_ONLY:-0}" == 1 ]]; then
  run_step "Applying checked-out chezmoi source state" \
    chezmoi --source "$repo_root" --destination "$target_home" apply --force
else
  run_step "Pulling and applying chezmoi source state" \
    chezmoi --source "$repo_root" --destination "$target_home" update --force
fi

node_version="$(<"$target_home/.node-version")"
node="$target_home/.local/opt/nvm/versions/node/v${node_version}/bin/node"
if [[ ! -x "$node" ]]; then
  printf 'sync: managed Node.js not found: %s\n' "$node" >&2
  exit 127
fi

run_step "Running shared Node.js sync" \
  "$node" "$target_home/.local/share/lazyvim/sync.mjs"
