{{- /* Generated by capability ownership split; pins are intentionally local to this manifest. */ -}}
{{- $versions := include "dot_local/share/workstation/versions.json" | fromJson -}}
{{- $nodeVersion := include "dot_node-version" | trim -}}
{{- $nodeURL := "" -}}{{- $nodeSha := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $nodeURL = printf "https://nodejs.org/dist/v%s/node-v%s-linux-x64.tar.xz" $nodeVersion $nodeVersion -}}
  {{- $nodeSha = "14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647" -}}
{{- else if eq .chezmoi.os "darwin" -}}
  {{- $nodeURL = printf "https://nodejs.org/dist/v%s/node-v%s-darwin-arm64.tar.xz" $nodeVersion $nodeVersion -}}
  {{- $nodeSha = "3f1cf157479c1480352083105e13faf9d008ede98e7e157746b6df940d197b94" -}}
{{- end -}}
[".local/opt/nvm"]
    type = "archive"
    url = {{ printf "https://github.com/nvm-sh/nvm/archive/refs/tags/v%s.tar.gz" $versions.nvm_sh | quote }}
    stripComponents = 1
    [".local/opt/nvm".checksum]
        sha256 = "5949b50e4640f2be2263f963952673d7f1a8745a83f05365e99f032fe78307fd"

[{{ printf ".local/opt/nvm/versions/node/v%s" $nodeVersion | quote }}]
    type = "archive"
    url = {{ $nodeURL | quote }}
    stripComponents = 1
    [{{ printf ".local/opt/nvm/versions/node/v%s" $nodeVersion | quote }}.checksum]
        sha256 = {{ $nodeSha | quote }}

