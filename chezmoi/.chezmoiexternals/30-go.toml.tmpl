{{- /* Generated by capability ownership split; pins are intentionally local to this manifest. */ -}}
{{- $versions := include "dot_local/share/workstation/versions.json" | fromJson -}}
{{- $goURL := "" -}}{{- $goSha := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $goURL = printf "https://go.dev/dl/go%s.linux-amd64.tar.gz" $versions.go -}}
  {{- $goSha = "63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445" -}}
{{- else if eq .chezmoi.os "darwin" -}}
  {{- $goURL = printf "https://go.dev/dl/go%s.darwin-arm64.tar.gz" $versions.go -}}
  {{- $goSha = "ee215d57e0ec269c60cc9ceca68e6bda321ba9ee5afe24f4b0988703c2d87d12" -}}
{{- end -}}
[".local/opt/go"]
    type = "archive"
    url = {{ $goURL | quote }}
    exact = true
    stripComponents = 1
    [".local/opt/go".checksum]
        sha256 = {{ $goSha | quote }}

