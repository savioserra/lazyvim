{{- /* Generated by capability ownership split; pins are intentionally local to this manifest. */ -}}
{{- $versions := include "dot_local/share/workstation/versions.json" | fromJson -}}
{{- $nvimURL := "" -}}{{- $nvimSha := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $nvimURL = printf "https://github.com/neovim/neovim/releases/download/v%s/nvim-linux-x86_64.tar.gz" $versions.neovim -}}
  {{- $nvimSha = "012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628" -}}
{{- else if eq .chezmoi.os "darwin" -}}
  {{- $nvimURL = printf "https://github.com/neovim/neovim/releases/download/v%s/nvim-macos-arm64.tar.gz" $versions.neovim -}}
  {{- $nvimSha = "51ab83afa66d663627c2ab1be43209b0f4e81360d4598b53efaa4d8195f24c89" -}}
{{- end -}}
[".local/opt/nvim"]
    type = "archive"
    url = {{ $nvimURL | quote }}
    exact = true
    stripComponents = 1
    [".local/opt/nvim".checksum]
        sha256 = {{ $nvimSha | quote }}

