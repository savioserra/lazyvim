{{- /* Windows only: see .chezmoiignore, which excludes this script elsewhere. */ -}}
# Add the directories .chezmoiexternal.toml.tmpl installs tools into to the
# user PATH once. Unix relies on the shell rc already having .local/bin on
# PATH; Windows has no such convention.
$ErrorActionPreference = "Stop"

$paths = @(
  (Join-Path $env:USERPROFILE ".local\bin"),
  (Join-Path $env:USERPROFILE ".local\opt\nvim\bin")
)

$current = [Environment]::GetEnvironmentVariable('Path', 'User')
$parts = @()
if ($current) {
  $parts = $current -split ';' | Where-Object { $_ -ne '' }
}

$changed = $false
foreach ($p in $paths) {
  if ($parts -notcontains $p) {
    $parts += $p
    $changed = $true
  }
}

if ($changed) {
  [Environment]::SetEnvironmentVariable('Path', ($parts -join ';'), 'User')
  Write-Host "Added to user PATH: $($paths -join ', ')"
  Write-Host "Open a new terminal for PATH changes to take effect."
}
