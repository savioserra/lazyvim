{{- /* Windows only: see .chezmoiignore, which excludes this script elsewhere. */ -}}
# Add the directories .chezmoiexternal.toml.tmpl installs tools into to the
# user PATH once. Unix relies on the shell rc already having .local/bin on
# PATH; Windows has no such convention.
$ErrorActionPreference = "Stop"

$paths = @(
  (Join-Path $env:USERPROFILE ".local\bin"),
  (Join-Path $env:USERPROFILE ".local\opt\nvim\bin"),
  (Join-Path $env:USERPROFILE ".local\opt\go\bin")
)

$current = [Environment]::GetEnvironmentVariable('Path', 'User')
$parts = @()
if ($current) {
  $parts = $current -split ';' | Where-Object { $_ -ne '' }
}

$changed = $false
foreach ($p in $paths) {
  if ($parts -notcontains $p) {
    $parts += $p
    $changed = $true
  }
}

if ($changed) {
  [Environment]::SetEnvironmentVariable('Path', ($parts -join ';'), 'User')
  Write-Host "Added to user PATH: $($paths -join ', ')"
}

# Neovim defaults to %LOCALAPPDATA%\nvim on Windows, while this cross-platform
# source state deploys it to ~/.config/nvim.
$xdgConfigHome = Join-Path $env:USERPROFILE '.config'
if ([Environment]::GetEnvironmentVariable('XDG_CONFIG_HOME', 'User') -ne $xdgConfigHome) {
  [Environment]::SetEnvironmentVariable('XDG_CONFIG_HOME', $xdgConfigHome, 'User')
  Write-Host "Set user XDG_CONFIG_HOME: $xdgConfigHome"
  $changed = $true
}

if ($changed) {
  Write-Host 'Open a new terminal for environment changes to take effect.'
}
