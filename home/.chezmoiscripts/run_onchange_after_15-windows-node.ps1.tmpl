{{- /* Windows only: see .chezmoiignore, which excludes this script elsewhere. */ -}}
# nvm-windows 1.2.2; keep this marker aligned with .chezmoiexternal.toml.tmpl.
$ErrorActionPreference = 'Stop'
$nodeVersion = '24.19.0'
$env:NVM_HOME = Join-Path $env:USERPROFILE '.local\opt\nvm-windows'
$env:NVM_SYMLINK = Join-Path $env:NVM_HOME 'nodejs'
$env:PATH = "$env:NVM_HOME;$env:NVM_SYMLINK;$env:PATH"
$nvm = Join-Path $env:NVM_HOME 'nvm.exe'
$settings = @(
  "root: $env:NVM_HOME"
  "path: $env:NVM_SYMLINK"
  'arch: 64'
  'proxy: none'
) -join "`r`n"
[IO.File]::WriteAllText((Join-Path $env:NVM_HOME 'settings.txt'), "$settings`r`n")

& $nvm install $nodeVersion
if ($LASTEXITCODE -ne 0) {
  throw "nvm install $nodeVersion failed with exit code $LASTEXITCODE"
}
& $nvm use $nodeVersion
if ($LASTEXITCODE -ne 0) {
  throw "nvm use $nodeVersion failed with exit code $LASTEXITCODE"
}
