#!/bin/sh
# Clone every tmux plugin (including TPM itself) directly at its exact
# pinned commit. TPM's own install mechanism clones via
# `git clone -b <ref> --single-branch`, which only accepts a branch or tag
# name, not a raw commit SHA -- so it can't do this pinning itself. TPM
# still *loads* each plugin at tmux startup (dot_tmux.conf's
# `run-shell '~/.tmux/plugins/tpm/tpm'`); this script only gets the right
# commit onto disk. Fixing drift on an already-cloned plugin is a manual
# re-run of this script, same tradeoff as :Lazy restore.
set -eu

plugins_dir="$HOME/.tmux/plugins"
mkdir -p "$plugins_dir"

# Removed because its bootstrap downloads an unversioned, unchecked binary and
# upstream publishes no Intel macOS binary. Clean the formerly managed checkout.
rm -rf "$plugins_dir/tmux-fingers"

install() {
  name="$1"
  url="$2"
  commit="$3"
  dir="$plugins_dir/$name"
  if [ ! -d "$dir" ]; then
    git clone --quiet "$url" "$dir"
  fi
  git -C "$dir" fetch --quiet origin "$commit" 2>/dev/null || true
  git -C "$dir" checkout --quiet "$commit"
}

install tpm https://github.com/tmux-plugins/tpm.git e261deb1b47614eed3400089ce7197dc68acc4eb
install tmux2k https://github.com/2KAbhishek/tmux2k.git 07b3228b56c1a7b6109f00009df80b53f7eae892
install tmux-yank https://github.com/tmux-plugins/tmux-yank.git acfd36e4fcba99f8310a7dfb432111c242fe7392
install vim-tmux-navigator https://github.com/christoomey/vim-tmux-navigator.git e41c431a0c7b7388ae7ba341f01a0d217eb3a432
install tmux-resurrect https://github.com/tmux-plugins/tmux-resurrect.git cff343cf9e81983d3da0c8562b01616f12e8d548
