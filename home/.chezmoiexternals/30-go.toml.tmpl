{{- /* Generated by capability ownership split; pins are intentionally local to this manifest. */ -}}
{{- $versions := include "dot_local/share/lazyvim/versions.json" | fromJson -}}
{{- $goURL := "" -}}{{- $goSha := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $goURL = printf "https://go.dev/dl/go%s.linux-amd64.tar.gz" $versions.go -}}
  {{- $goSha = "675c26c449cbb18fc24b74650de1eabbae6e16f64326fd85a283fb3b58280685" -}}
{{- else if eq .chezmoi.os "darwin" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    {{- $goURL = printf "https://go.dev/dl/go%s.darwin-arm64.tar.gz" $versions.go -}}
    {{- $goSha = "90493b3bbd5e10f91d12153198bf1994fd756399b4fec93b49b0c6e2acdeeb3e" -}}
  {{- else -}}
    {{- $goURL = printf "https://go.dev/dl/go%s.darwin-amd64.tar.gz" $versions.go -}}
    {{- $goSha = "d3314e25496e4381d71a5c51d2907e7af655d199f6780b549f015bd85fef4986" -}}
  {{- end -}}
{{- else if eq .chezmoi.os "windows" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    {{- $goURL = printf "https://go.dev/dl/go%s.windows-arm64.zip" $versions.go -}}
    {{- $goSha = "6e0156b9788209931dd340fadc04171ce15063c17b51c92e7b86b51109626e90" -}}
  {{- else -}}
    {{- $goURL = printf "https://go.dev/dl/go%s.windows-amd64.zip" $versions.go -}}
    {{- $goSha = "f0c0a0d33ba94f4d2c5dbc887334ce678b21813504ddb3aafcb06e60a5a667c4" -}}
  {{- end -}}
{{- end -}}
[".local/opt/go"]
    type = "archive"
    url = {{ $goURL | quote }}
    exact = true
    stripComponents = 1
    [".local/opt/go".checksum]
        sha256 = {{ $goSha | quote }}

