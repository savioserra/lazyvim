{{- /* Generated by capability ownership split; pins are intentionally local to this manifest. */ -}}
{{- $versions := include "dot_local/share/workstation/versions.json" | fromJson -}}
{{- $rgVersion := $versions.ripgrep -}}
{{- $fdVersion := $versions.fd -}}
{{- $rgURL := "" -}}{{- $rgPath := "" -}}{{- $rgSha := "" -}}
{{- $fdURL := "" -}}{{- $fdPath := "" -}}{{- $fdSha := "" -}}
{{- $fzfURL := "" -}}{{- $fzfSha := "" -}}
{{- $lazygitURL := "" -}}{{- $lazygitSha := "" -}}
{{- $treeSitterURL := "" -}}{{- $treeSitterSha := "" -}}
{{- $rainfrogURL := "" -}}{{- $rainfrogSha := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $rgURL = printf "https://github.com/BurntSushi/ripgrep/releases/download/%s/ripgrep-%s-x86_64-unknown-linux-musl.tar.gz" $rgVersion $rgVersion -}}
  {{- $rgPath = printf "ripgrep-%s-x86_64-unknown-linux-musl/rg" $rgVersion -}}
  {{- $rgSha = "33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c" -}}
  {{- $fdURL = printf "https://github.com/sharkdp/fd/releases/download/v%s/fd-v%s-x86_64-unknown-linux-gnu.tar.gz" $fdVersion $fdVersion -}}
  {{- $fdPath = printf "fd-v%s-x86_64-unknown-linux-gnu/fd" $fdVersion -}}
  {{- $fdSha = "def59805cd14b5651b68990855f426ad087f3b96881296d963910431ba3143c8" -}}
  {{- $fzfURL = printf "https://github.com/junegunn/fzf/releases/download/v%s/fzf-%s-linux_amd64.tar.gz" $versions.fzf $versions.fzf -}}
  {{- $fzfSha = "b3648f48675612b69ee35371cf6dc99ca96d767e89b912d079080916ac8ba8bd" -}}
  {{- $lazygitURL = printf "https://github.com/jesseduffield/lazygit/releases/download/v%s/lazygit_%s_linux_x86_64.tar.gz" $versions.lazygit $versions.lazygit -}}
  {{- $lazygitSha = "8e033bc78c8e192dee9510e951f6c9e154289b7198d22c924ed1d0a951b0dac1" -}}
  {{- $treeSitterURL = printf "https://github.com/tree-sitter/tree-sitter/releases/download/v%s/tree-sitter-cli-linux-x64.zip" $versions.tree_sitter -}}
  {{- $treeSitterSha = "ff1b7f9863f2faafd78dc0e66d902ee85b37f709b314b22c009f51caf233eebd" -}}
  {{- $rainfrogURL = printf "https://github.com/achristmascarl/rainfrog/releases/download/v%s/rainfrog-v%s-x86_64-unknown-linux-musl.tar.gz" $versions.rainfrog $versions.rainfrog -}}
  {{- $rainfrogSha = "b3712391ec2c07c705fc5fd1ca1eb4b7246c8b104f94a9cdb626a08c7d1b3abd" -}}
{{- else if eq .chezmoi.os "darwin" -}}
    {{- $rgURL = printf "https://github.com/BurntSushi/ripgrep/releases/download/%s/ripgrep-%s-aarch64-apple-darwin.tar.gz" $rgVersion $rgVersion -}}
    {{- $rgPath = printf "ripgrep-%s-aarch64-apple-darwin/rg" $rgVersion -}}
    {{- $rgSha = "3750b2e93f37e0c692657da574d7019a101c0084da05a790c83fd335bad973e4" -}}
    {{- $fdURL = printf "https://github.com/sharkdp/fd/releases/download/v%s/fd-v%s-aarch64-apple-darwin.tar.gz" $fdVersion $fdVersion -}}
    {{- $fdPath = printf "fd-v%s-aarch64-apple-darwin/fd" $fdVersion -}}
    {{- $fdSha = "623dc0afc81b92e4d4606b380d7bc91916ba7b97814263e554d50923a39e480a" -}}
    {{- $fzfURL = printf "https://github.com/junegunn/fzf/releases/download/v%s/fzf-%s-darwin_arm64.tar.gz" $versions.fzf $versions.fzf -}}
    {{- $fzfSha = "d60ddb36356566ac69bae7c3504e888916cf747c9ad2132141c09229b1e28dee" -}}
    {{- $lazygitURL = printf "https://github.com/jesseduffield/lazygit/releases/download/v%s/lazygit_%s_darwin_arm64.tar.gz" $versions.lazygit $versions.lazygit -}}
    {{- $lazygitSha = "b963e9d0a1f4649708c594ac6c999cdcd435f8e679e220e78e87c4642badedd6" -}}
    {{- $treeSitterURL = printf "https://github.com/tree-sitter/tree-sitter/releases/download/v%s/tree-sitter-cli-macos-arm64.zip" $versions.tree_sitter -}}
    {{- $treeSitterSha = "050f41d60a054b608ea392ba14722bba9457bdc0ab11a5706c77f034dafc68ac" -}}
    {{- $rainfrogURL = printf "https://github.com/achristmascarl/rainfrog/releases/download/v%s/rainfrog-v%s-aarch64-apple-darwin.tar.gz" $versions.rainfrog $versions.rainfrog -}}
    {{- $rainfrogSha = "29d1ddb19b4d2c3888c7abf61b0f6fe9c99e3df309418ca59e449fa11b0c1a9f" -}}
{{- end -}}
[".local/bin/rg"]
    type = "archive-file"
    url = {{ $rgURL | quote }}
    path = {{ $rgPath | quote }}
    executable = true
    [".local/bin/rg".checksum]
        sha256 = {{ $rgSha | quote }}

[".local/bin/fd"]
    type = "archive-file"
    url = {{ $fdURL | quote }}
    path = {{ $fdPath | quote }}
    executable = true
    [".local/bin/fd".checksum]
        sha256 = {{ $fdSha | quote }}

[".local/bin/fzf"]
    type = "archive-file"
    url = {{ $fzfURL | quote }}
    path = "fzf"
    executable = true
    [".local/bin/fzf".checksum]
        sha256 = {{ $fzfSha | quote }}

[".local/bin/lazygit"]
    type = "archive-file"
    url = {{ $lazygitURL | quote }}
    path = "lazygit"
    executable = true
    [".local/bin/lazygit".checksum]
        sha256 = {{ $lazygitSha | quote }}

[".local/bin/tree-sitter"]
    type = "archive-file"
    url = {{ $treeSitterURL | quote }}
    path = "tree-sitter"
    executable = true
    [".local/bin/tree-sitter".checksum]
        sha256 = {{ $treeSitterSha | quote }}

{{- if ne $rainfrogURL "" }}

[".local/bin/rainfrog"]
    type = "archive-file"
    url = {{ $rainfrogURL | quote }}
    path = "rainfrog"
    executable = true
    [".local/bin/rainfrog".checksum]
        sha256 = {{ $rainfrogSha | quote }}
{{- end }}

