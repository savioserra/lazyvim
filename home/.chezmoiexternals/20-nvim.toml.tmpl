{{- /* Generated by capability ownership split; pins are intentionally local to this manifest. */ -}}
{{- $versions := include "dot_local/share/lazyvim/versions.json" | fromJson -}}
{{- $nvimURL := "" -}}{{- $nvimSha := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $nvimURL = printf "https://github.com/neovim/neovim/releases/download/v%s/nvim-linux-x86_64.tar.gz" $versions.neovim -}}
  {{- $nvimSha = "012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628" -}}
{{- else if eq .chezmoi.os "darwin" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    {{- $nvimURL = printf "https://github.com/neovim/neovim/releases/download/v%s/nvim-macos-arm64.tar.gz" $versions.neovim -}}
    {{- $nvimSha = "51ab83afa66d663627c2ab1be43209b0f4e81360d4598b53efaa4d8195f24c89" -}}
  {{- else -}}
    {{- $nvimURL = printf "https://github.com/neovim/neovim/releases/download/v%s/nvim-macos-x86_64.tar.gz" $versions.neovim -}}
    {{- $nvimSha = "03fe16f8dd9f1e9eaf52d5e294913a39917b9e2faea30d7fb0fb385fbd36fe59" -}}
  {{- end -}}
{{- else if eq .chezmoi.os "windows" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    {{- $nvimURL = printf "https://github.com/neovim/neovim/releases/download/v%s/nvim-win-arm64.zip" $versions.neovim -}}
    {{- $nvimSha = "49906085a3c473ee87a28319942c62216fb365a1a1a4f83dbc4ac41365f5e609" -}}
  {{- else -}}
    {{- $nvimURL = printf "https://github.com/neovim/neovim/releases/download/v%s/nvim-win64.zip" $versions.neovim -}}
    {{- $nvimSha = "9fc3572829ffd13debb6e32555da2c8cc02555568260a9fc4cf1f65bbcca319c" -}}
  {{- end -}}
{{- end -}}
[".local/opt/nvim"]
    type = "archive"
    url = {{ $nvimURL | quote }}
    exact = true
    stripComponents = 1
    [".local/opt/nvim".checksum]
        sha256 = {{ $nvimSha | quote }}

