{{- /* Generated by capability ownership split; pins are intentionally local to this manifest. */ -}}
{{- $versions := include "dot_local/share/workstation/versions.json" | fromJson -}}
{{- $fontURL := "" -}}{{- $fontSha := "" -}}{{- $fontKind := "tar.xz" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $fontURL = printf "https://github.com/ryanoasis/nerd-fonts/releases/download/v%s/JetBrainsMono.tar.xz" $versions.font -}}
  {{- $fontSha = "0227b220360a6f819b9ead92343e8112b34733054782561af50cfba1e8afab63" -}}
{{- else if eq .chezmoi.os "darwin" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
  {{- else -}}
  {{- end -}}
  {{- $fontURL = printf "https://github.com/ryanoasis/nerd-fonts/releases/download/v%s/JetBrainsMono.tar.xz" $versions.font -}}
  {{- $fontSha = "0227b220360a6f819b9ead92343e8112b34733054782561af50cfba1e8afab63" -}}
{{- else if eq .chezmoi.os "windows" -}}
  {{- $fontKind = "zip" -}}
  {{- $fontURL = printf "https://github.com/ryanoasis/nerd-fonts/releases/download/v%s/JetBrainsMono.zip" $versions.font -}}
  {{- $fontSha = "9577de1ae84ec523df16fc69bac5338b89497a5b4fb91489e2dcb79dc06ac2b5" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
  {{- else -}}
  {{- end -}}
{{- end -}}
{{- if eq .chezmoi.os "windows" }}

[{{ printf "AppData/Local/Microsoft/Windows/Fonts/JetBrainsMonoNerdFont" | quote }}]
    type = "archive"
    url = {{ $fontURL | quote }}
    exact = true
    [{{ printf "AppData/Local/Microsoft/Windows/Fonts/JetBrainsMonoNerdFont" | quote }}.checksum]
        sha256 = {{ $fontSha | quote }}
{{- else if eq .chezmoi.os "darwin" }}

["Library/Fonts/JetBrainsMonoNerdFont"]
    type = "archive"
    url = {{ $fontURL | quote }}
    exact = true
    ["Library/Fonts/JetBrainsMonoNerdFont".checksum]
        sha256 = {{ $fontSha | quote }}
{{- else }}

[".local/share/fonts/JetBrainsMonoNerdFont"]
    type = "archive"
    url = {{ $fontURL | quote }}
    exact = true
    [".local/share/fonts/JetBrainsMonoNerdFont".checksum]
        sha256 = {{ $fontSha | quote }}
{{- end }}
