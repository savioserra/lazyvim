{{- /* Generated by capability ownership split; pins are intentionally local to this manifest. */ -}}
{{- $versions := include "dot_local/share/lazyvim/versions.json" | fromJson -}}
{{- $nvmWindowsURL := "" -}}{{- $nvmWindowsSha := "" -}}
{{- $nodeVersion := include "dot_node-version" | trim -}}
{{- $nodeURL := "" -}}{{- $nodeSha := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $nodeURL = printf "https://nodejs.org/dist/v%s/node-v%s-linux-x64.tar.xz" $nodeVersion $nodeVersion -}}
  {{- $nodeSha = "14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647" -}}
{{- else if eq .chezmoi.os "darwin" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    {{- $nodeURL = printf "https://nodejs.org/dist/v%s/node-v%s-darwin-arm64.tar.xz" $nodeVersion $nodeVersion -}}
    {{- $nodeSha = "3f1cf157479c1480352083105e13faf9d008ede98e7e157746b6df940d197b94" -}}
  {{- else -}}
    {{- $nodeURL = printf "https://nodejs.org/dist/v%s/node-v%s-darwin-x64.tar.xz" $nodeVersion $nodeVersion -}}
    {{- $nodeSha = "d35e95230f46f6f0751df497c56622c6735e05d5e1fb1630996a005b9d328fe4" -}}
  {{- end -}}
{{- else if eq .chezmoi.os "windows" -}}
  {{- $nvmWindowsURL = printf "https://github.com/coreybutler/nvm-windows/releases/download/%s/nvm-noinstall.zip" $versions.nvm_windows -}}
  {{- $nvmWindowsSha = "74232ea51c060ecd44ecf2cebee314ed9e3f6da56e1f9484d8d46c4e8bb6ae0e" -}}
  {{- if eq .chezmoi.arch "arm64" -}}
    {{- $nodeURL = printf "https://nodejs.org/dist/v%s/node-v%s-win-arm64.zip" $nodeVersion $nodeVersion -}}
    {{- $nodeSha = "8502f4a50b458d4cc38ed8f2001556c2cd239d464920f74017926ccb1e1c157f" -}}
  {{- else -}}
    {{- $nodeURL = printf "https://nodejs.org/dist/v%s/node-v%s-win-x64.zip" $nodeVersion $nodeVersion -}}
    {{- $nodeSha = "57f71ab3652e797d84acddc79c81cc9ff1c6ddb2a1974cdb83f00fee9bff4c73" -}}
  {{- end -}}
{{- end -}}
{{- if eq .chezmoi.os "windows" }}

[".local/opt/nvm-windows"]
    type = "archive"
    url = {{ $nvmWindowsURL | quote }}
    [".local/opt/nvm-windows".checksum]
        sha256 = {{ $nvmWindowsSha | quote }}

[{{ printf ".local/opt/nvm-windows/v%s" $nodeVersion | quote }}]
    type = "archive"
    url = {{ $nodeURL | quote }}
    exact = true
    stripComponents = 1
    [{{ printf ".local/opt/nvm-windows/v%s" $nodeVersion | quote }}.checksum]
        sha256 = {{ $nodeSha | quote }}
{{- else }}

[".local/opt/nvm"]
    type = "archive"
    url = {{ printf "https://github.com/nvm-sh/nvm/archive/refs/tags/v%s.tar.gz" $versions.nvm_sh | quote }}
    stripComponents = 1
    [".local/opt/nvm".checksum]
        sha256 = "5949b50e4640f2be2263f963952673d7f1a8745a83f05365e99f032fe78307fd"

[{{ printf ".local/opt/nvm/versions/node/v%s" $nodeVersion | quote }}]
    type = "archive"
    url = {{ $nodeURL | quote }}
    stripComponents = 1
    [{{ printf ".local/opt/nvm/versions/node/v%s" $nodeVersion | quote }}.checksum]
        sha256 = {{ $nodeSha | quote }}
{{- end }}

