[Unit]
Description=Workstation GoAkt subagents daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
RuntimeDirectory=ws-subagents
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -m 0600 %h/.config/workstation/subagents/config.toml %t/ws-subagents/config.toml
ExecStart=%h/.local/bin/workstation-subagents --config %t/ws-subagents/config.toml
Restart=on-failure
RestartSec=5s
# Hosted tmux/Pi processes are exactly owned durable runtimes. Signal only the
# daemon so its shutdown can quiesce projections and the replacement can adopt
# those processes; explicit actor STOP performs exact destructive cleanup.
KillMode=process
UMask=0077
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_STATE_HOME=%h/.local/state
Environment=XDG_RUNTIME_DIR=%t
Environment=PATH=%h/.local/opt/nvm/versions/node/v24.19.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Descriptor-relative no-follow validation in the daemon requires opening the
# filesystem root. ProtectSystem mount namespaces deny that operation, so path
# confinement is enforced by securepath plus owner-private modes instead.
NoNewPrivileges=true

[Install]
WantedBy=default.target
